<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <Product>Condec</Product>
    <Authors>Condec contributors</Authors>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>

    <!-- Shared Windows target. Keep the app and Condec.Core on the same platform version. -->
    <CondecWindowsTargetFramework>net10.0-windows10.0.26100.0</CondecWindowsTargetFramework>
    <CondecWindowsMinVersion>10.0.17763.0</CondecWindowsMinVersion>

    <!-- Lets non-Windows dev machines compile the Windows-targeted parts of Condec.Core.
         The WinUI app itself still needs Windows (its XAML compiler is a .NET Framework executable). -->
    <EnableWindowsTargeting Condition="'$(OS)' != 'Windows_NT'">true</EnableWindowsTargeting>
  </PropertyGroup>

  <!-- The source tree is synced to Windows machines. Keep non-Windows build output out of it,
       so Linux bin/obj never mix with (or get synced over) a Windows build. -->
  <PropertyGroup Condition="'$(OS)' != 'Windows_NT' and '$(ArtifactsPath)' == ''">
    <ArtifactsPath>$([System.Environment]::GetFolderPath(SpecialFolder.UserProfile))/.cache/condec-artifacts</ArtifactsPath>
  </PropertyGroup>
</Project>
