<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Pins the transitive Windows App SDK components below. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Windows App SDK 2.5.1 (component packages, framework-dependent)">
    <!-- Microsoft.WindowsAppSDK.Runtime fails the build unless every referenced component
         matches the exact versions it was generated with (VerifyReferencedWindowsAppSdkComponentVersions).
         These are the versions pinned by the Microsoft.WindowsAppSDK 2.5.1 metapackage. -->
    <PackageVersion Include="Microsoft.WindowsAppSDK.Runtime" Version="2.5.1" />
    <PackageVersion Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <PackageVersion Include="Microsoft.WindowsAppSDK.Foundation" Version="2.3.12" />
    <PackageVersion Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" />
    <PackageVersion Include="Microsoft.WindowsAppSDK.Base" Version="2.0.4" />
  </ItemGroup>

  <ItemGroup Label="Libraries">
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="PdfPig" Version="0.1.16" />
    <PackageVersion Include="ACadSharp" Version="3.8.0" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.1" />
  </ItemGroup>
</Project>
