<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Condec.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Condec"
    xmlns:vm="using:Condec.ViewModels"
    Title="Condec">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Height="32">
            <StackPanel
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="16">
                <Image
                    Width="16"
                    Height="16"
                    AutomationProperties.AccessibilityView="Raw"
                    Source="ms-appx:///Assets/TitleBarIcon.png" />
                <TextBlock
                    x:Name="AppTitleText"
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Condec" />
            </StackPanel>
        </Grid>

        <!--  The page scrolls only when the window or text size leaves no room; normally the history card takes the rest.  -->
        <ScrollViewer
            x:Name="PageScroller"
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <!--  Width and Height are set in code, see UpdatePageSize.  -->
            <Grid
                x:Name="PageContent"
                Margin="40,24,40,32"
                RowSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel x:Name="HeaderPanel" Spacing="4">
                    <TextBlock
                        AutomationProperties.HeadingLevel="Level1"
                        Style="{StaticResource TitleTextBlockStyle}"
                        Text="Konversi file" />
                    <TextBlock Style="{StaticResource SecondaryBodyTextStyle}" Text="Pilih file, tentukan format tujuan, lalu simpan." />
                </StackPanel>

                <!--  Converter card: one of four views is visible at a time.  -->
                <Border
                    x:Name="ConverterCard"
                    Grid.Row="1"
                    Padding="24"
                    Style="{StaticResource CardBorderStyle}">
                    <Grid>

                        <!--  Input  -->
                        <Grid Visibility="{x:Bind ViewModel.IsInput, Mode=OneWay}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <InfoBar
                                Margin="0,0,0,20"
                                CloseButtonCommand="{x:Bind ViewModel.DismissInputMessageCommand}"
                                IsOpen="{x:Bind ViewModel.HasInputMessage, Mode=OneWay}"
                                Message="{x:Bind ViewModel.InputMessage, Mode=OneWay}"
                                Severity="{x:Bind ViewModel.InputMessageSeverity, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.HasInputMessage, Mode=OneWay}" />

                            <Grid Grid.Row="1" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!--  Source file panel, also the drop target.  -->
                                <Grid
                                    Height="168"
                                    AllowDrop="True"
                                    DragOver="OnSourceDragOver"
                                    Drop="OnSourceDrop">
                                    <Grid Visibility="{x:Bind ViewModel.HasNoSource, Mode=OneWay}">
                                        <Rectangle
                                            Fill="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            RadiusX="8"
                                            RadiusY="8"
                                            Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                                            StrokeDashArray="4,3"
                                            StrokeThickness="1" />
                                        <StackPanel
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Spacing="8">
                                            <FontIcon
                                                HorizontalAlignment="Center"
                                                AutomationProperties.AccessibilityView="Raw"
                                                FontSize="32"
                                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                Glyph="&#xE898;" />
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                Style="{StaticResource BodyTextBlockStyle}"
                                                Text="Seret file ke sini" />
                                            <Button
                                                x:Name="PickFileButton"
                                                HorizontalAlignment="Center"
                                                Command="{x:Bind ViewModel.PickSourceCommand}"
                                                Content="Pilih file…" />
                                        </StackPanel>
                                    </Grid>

                                    <Border
                                        Padding="24"
                                        Style="{StaticResource InnerPanelBorderStyle}"
                                        Visibility="{x:Bind ViewModel.HasSource, Mode=OneWay}">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon
                                                VerticalAlignment="Center"
                                                AutomationProperties.AccessibilityView="Raw"
                                                FontSize="40"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Glyph="{x:Bind ViewModel.Source.Glyph, Mode=OneWay, FallbackValue=''}" />
                                            <StackPanel
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Spacing="2">
                                                <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="File sumber" />
                                                <TextBlock
                                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                                    Text="{x:Bind ViewModel.Source.Name, Mode=OneWay, FallbackValue=''}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="NoWrap"
                                                    ToolTipService.ToolTip="{x:Bind ViewModel.Source.Path, Mode=OneWay, FallbackValue=''}" />
                                                <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind ViewModel.Source.Description, Mode=OneWay, FallbackValue=''}" />
                                            </StackPanel>
                                            <HyperlinkButton
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="Ganti file sumber"
                                                Command="{x:Bind ViewModel.PickSourceCommand}"
                                                Content="Ganti" />
                                        </Grid>
                                    </Border>
                                </Grid>

                                <FontIcon
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AccessibilityView="Raw"
                                    FontSize="24"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="&#xE72A;" />

                                <!--  Target format panel  -->
                                <Border
                                    Grid.Column="2"
                                    Height="168"
                                    Padding="24"
                                    Style="{StaticResource InnerPanelBorderStyle}">
                                    <StackPanel VerticalAlignment="Center" Spacing="8">
                                        <ComboBox
                                            x:Name="FormatComboBox"
                                            SelectionChanged="FormatComboBox_SelectionChanged"
                                            HorizontalAlignment="Stretch"
                                            Header="Ubah ke format"
                                            IsEnabled="{x:Bind ViewModel.HasSource, Mode=OneWay}"
                                            ItemsSource="{x:Bind ViewModel.TargetOptions}"
                                            PlaceholderText="{x:Bind ViewModel.FormatPlaceholder, Mode=OneWay}"
                                            SelectedItem="{x:Bind ViewModel.SelectedTarget, Mode=TwoWay}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:FormatOption">
                                                    <Grid ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{x:Bind DisplayName}" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            Style="{StaticResource SecondaryCaptionTextStyle}"
                                                            Text="{x:Bind Caption}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind ViewModel.FormatHelpText, Mode=OneWay}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!--  PDF options: the page for image and CAD targets; unit, scale and switches for CAD only.  -->
                            <StackPanel
                                Grid.Row="2"
                                Margin="0,20,0,0"
                                Spacing="16"
                                Visibility="{x:Bind ViewModel.ShowsPageChoice, Mode=OneWay}">
                                <InfoBar
                                    Title="{x:Bind ViewModel.Pdf.KindTitle, Mode=OneWay}"
                                    IsClosable="False"
                                    IsOpen="True"
                                    Message="{x:Bind ViewModel.Pdf.KindMessage, Mode=OneWay}"
                                    Severity="{x:Bind ViewModel.Pdf.KindSeverity, Mode=OneWay}"
                                    Visibility="{x:Bind VisibleWhenBoth(ViewModel.ShowsCadOptions, ViewModel.Pdf.HasKind), Mode=OneWay}">
                                    <InfoBar.ActionButton>
                                        <Button
                                            Command="{x:Bind ViewModel.PickSourceCommand}"
                                            Content="Pilih file lain"
                                            Visibility="{x:Bind ViewModel.Pdf.IsScan, Mode=OneWay}" />
                                    </InfoBar.ActionButton>
                                </InfoBar>

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox
                                        HorizontalAlignment="Stretch"
                                        Header="Satuan gambar"
                                        ItemsSource="{x:Bind ViewModel.Pdf.Units}"
                                        SelectedItem="{x:Bind ViewModel.Pdf.SelectedUnit, Mode=TwoWay}"
                                        Visibility="{x:Bind ViewModel.ShowsCadOptions, Mode=OneWay}" />
                                    <StackPanel
                                        Grid.Column="1"
                                        Spacing="8"
                                        Visibility="{x:Bind ViewModel.ShowsCadOptions, Mode=OneWay}">
                                        <ComboBox
                                            HorizontalAlignment="Stretch"
                                            Header="Skala gambar"
                                            ItemsSource="{x:Bind ViewModel.Pdf.Scales}"
                                            SelectedItem="{x:Bind ViewModel.Pdf.SelectedScale, Mode=TwoWay}" />
                                        <NumberBox
                                            AutomationProperties.Name="Skala kustom, 1 banding"
                                            Header="Skala kustom, 1 : n"
                                            Minimum="1"
                                            PlaceholderText="1 : n"
                                            SpinButtonPlacementMode="Compact"
                                            Value="{x:Bind ViewModel.Pdf.CustomDenominator, Mode=TwoWay}"
                                            Visibility="{x:Bind ViewModel.Pdf.IsCustomScale, Mode=OneWay}" />
                                    </StackPanel>
                                    <ComboBox
                                        Grid.Column="{x:Bind PageColumn(ViewModel.ShowsCadOptions), Mode=OneWay}"
                                        HorizontalAlignment="Stretch"
                                        Header="Halaman"
                                        ItemsSource="{x:Bind ViewModel.Pdf.Pages, Mode=OneWay}"
                                        SelectedItem="{x:Bind ViewModel.Pdf.SelectedPage, Mode=TwoWay}" />
                                </Grid>

                                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.ShowsCadOptions, Mode=OneWay}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="Pertahankan teks sebagai teks" />
                                            <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind ViewModel.Pdf.KeepTextNote, Mode=OneWay}" />
                                        </StackPanel>
                                        <ToggleSwitch
                                            Grid.Column="1"
                                            MinWidth="0"
                                            AutomationProperties.Name="Pertahankan teks sebagai teks"
                                            IsEnabled="{x:Bind ViewModel.Pdf.CanKeepText, Mode=OneWay}"
                                            IsOn="{x:Bind ViewModel.Pdf.KeepText, Mode=TwoWay}"
                                            OffContent=""
                                            OnContent="" />
                                    </Grid>
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="Gabungkan garis bersambung" />
                                            <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="Menjadi satu polyline" />
                                        </StackPanel>
                                        <ToggleSwitch
                                            Grid.Column="1"
                                            MinWidth="0"
                                            AutomationProperties.Name="Gabungkan garis bersambung"
                                            IsOn="{x:Bind ViewModel.Pdf.JoinLines, Mode=TwoWay}"
                                            OffContent=""
                                            OnContent="" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>

                            <Grid
                                Grid.Row="3"
                                Margin="0,20,0,0"
                                ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <FontIcon
                                        AutomationProperties.AccessibilityView="Raw"
                                        FontSize="16"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="&#xEA18;" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SecondaryCaptionTextStyle}"
                                        Text="Diproses sepenuhnya di perangkat ini. Tidak ada file yang diunggah." />
                                </StackPanel>
                                <Button
                                    x:Name="ConvertButton"
                                    Grid.Column="1"
                                    Command="{x:Bind ViewModel.ConvertCommand}"
                                    Content="{x:Bind ViewModel.ConvertLabel, Mode=OneWay}"
                                    Style="{StaticResource AccentButtonStyle}" />
                            </Grid>
                        </Grid>

                        <!--  Processing  -->
                        <StackPanel Spacing="20" Visibility="{x:Bind ViewModel.IsProcessing, Mode=OneWay}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        AutomationProperties.HeadingLevel="Level2"
                                        Style="{StaticResource SubtitleTextBlockStyle}"
                                        Text="{x:Bind ViewModel.ProcessingTitle, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap" />
                                    <TextBlock
                                        Style="{StaticResource SecondaryCaptionTextStyle}"
                                        Text="{x:Bind ViewModel.ProcessingCaption, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap" />
                                </StackPanel>
                                <Button
                                    x:Name="CancelButton"
                                    Grid.Column="1"
                                    VerticalAlignment="Top"
                                    Command="{x:Bind ViewModel.CancelCommand}"
                                    Content="Batal">
                                    <Button.KeyboardAccelerators>
                                        <KeyboardAccelerator Key="Escape" />
                                    </Button.KeyboardAccelerators>
                                </Button>
                            </Grid>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <ProgressBar
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Kemajuan konversi"
                                    Maximum="100"
                                    Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}" />
                                <TextBlock
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" />
                            </Grid>

                            <ItemsControl IsTabStop="False" ItemsSource="{x:Bind ViewModel.Steps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ConversionStepViewModel">
                                        <Grid
                                            Height="40"
                                            AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}"
                                            ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Grid
                                                Width="20"
                                                Height="20"
                                                Visibility="{x:Bind IsDone, Mode=OneWay}">
                                                <Ellipse Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                                                <FontIcon
                                                    AutomationProperties.AccessibilityView="Raw"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                    Glyph="&#xE73E;" />
                                            </Grid>
                                            <ProgressRing
                                                Width="20"
                                                Height="20"
                                                IsActive="{x:Bind IsActive, Mode=OneWay}"
                                                Visibility="{x:Bind IsActive, Mode=OneWay}" />
                                            <Ellipse
                                                Width="18"
                                                Height="18"
                                                Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                                                StrokeThickness="1"
                                                Visibility="{x:Bind IsWaiting, Mode=OneWay}" />

                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Style="{x:Bind local:MainWindow.StepLabelStyle(State), Mode=OneWay}"
                                                Text="{x:Bind Label}" />
                                            <TextBlock
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource SecondaryCaptionTextStyle}"
                                                Text="{x:Bind Detail, Mode=OneWay}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!--  Done  -->
                        <StackPanel Spacing="20" Visibility="{x:Bind ViewModel.IsDone, Mode=OneWay}">
                            <InfoBar
                                IsClosable="False"
                                IsOpen="True"
                                Message="File berhasil disimpan dan lolos verifikasi chunk serta cek integritas."
                                Severity="Success"
                                Title="Konversi selesai" />
                            <Grid ColumnSpacing="16" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource SecondaryBodyTextStyle}" Text="Lokasi" />
                                <TextBlock
                                    Grid.Column="1"
                                    IsTextSelectionEnabled="True"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="{x:Bind ViewModel.Result.OutputPath, Mode=OneWay, FallbackValue=''}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.Result.OutputPath, Mode=OneWay, FallbackValue=''}" />
                                <TextBlock
                                    Grid.Row="1"
                                    Style="{StaticResource SecondaryBodyTextStyle}"
                                    Text="Format" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="{x:Bind ViewModel.ConversionFormat, Mode=OneWay}" />
                                <TextBlock
                                    Grid.Row="2"
                                    Style="{StaticResource SecondaryBodyTextStyle}"
                                    Text="Integritas" />
                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="{x:Bind ViewModel.ResultIntegrity, Mode=OneWay}" />
                            </Grid>
                            <StackPanel>
                                <InfoBar
                                    Margin="0,0,0,20"
                                    IsClosable="False"
                                    IsOpen="{x:Bind ViewModel.HasResultMessage, Mode=OneWay}"
                                    Message="{x:Bind ViewModel.ResultMessage, Mode=OneWay}"
                                    Severity="Warning"
                                    Visibility="{x:Bind ViewModel.HasResultMessage, Mode=OneWay}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button
                                        x:Name="OpenResultButton"
                                        Command="{x:Bind ViewModel.OpenResultCommand}"
                                        Content="Buka file"
                                        Style="{StaticResource AccentButtonStyle}" />
                                    <Button Command="{x:Bind ViewModel.ShowResultInFolderCommand}" Content="Tampilkan di folder" />
                                    <HyperlinkButton Command="{x:Bind ViewModel.ConvertAnotherCommand}" Content="Konversi file lain" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!--  Failed  -->
                        <StackPanel Spacing="20" Visibility="{x:Bind ViewModel.IsFailed, Mode=OneWay}">
                            <InfoBar
                                IsClosable="False"
                                IsOpen="True"
                                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                                Severity="Error"
                                Title="Konversi gagal" />
                            <Grid ColumnSpacing="16" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource SecondaryBodyTextStyle}" Text="File" />
                                <TextBlock
                                    Grid.Column="1"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="{x:Bind ViewModel.Source.Name, Mode=OneWay, FallbackValue=''}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                                <TextBlock
                                    Grid.Row="1"
                                    Style="{StaticResource SecondaryBodyTextStyle}"
                                    Text="Format" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="{x:Bind ViewModel.ConversionFormat, Mode=OneWay}" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    x:Name="RetryButton"
                                    Command="{x:Bind ViewModel.RetryCommand}"
                                    Content="Coba lagi"
                                    Style="{StaticResource AccentButtonStyle}" />
                                <Button Command="{x:Bind ViewModel.BackToInputCommand}" Content="Ubah pilihan" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  History card, filling the rest of the window.  -->
                <Border
                    x:Name="HistoryCard"
                    Grid.Row="2"
                    MinHeight="160"
                    Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Padding="24,12,16,8" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                AutomationProperties.HeadingLevel="Level2"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="Riwayat" />
                            <CheckBox
                                Grid.Column="1"
                                MinWidth="0"
                                Content="Catat riwayat"
                                IsChecked="{x:Bind ViewModel.IsHistoryEnabled, Mode=TwoWay}" />
                            <HyperlinkButton
                                Grid.Column="2"
                                Click="OnClearHistoryClicked"
                                Content="Hapus riwayat"
                                IsEnabled="{x:Bind ViewModel.HasHistory, Mode=OneWay}">
                                <FlyoutBase.AttachedFlyout>
                                    <Flyout x:Name="ClearHistoryFlyout">
                                        <StackPanel MaxWidth="280" Spacing="12">
                                            <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="Hapus semua riwayat? File hasil konversi tidak ikut terhapus." />
                                            <Button
                                                Click="OnClearHistoryConfirmed"
                                                Command="{x:Bind ViewModel.ClearHistoryCommand}"
                                                Content="Hapus" />
                                        </StackPanel>
                                    </Flyout>
                                </FlyoutBase.AttachedFlyout>
                            </HyperlinkButton>
                        </Grid>

                        <InfoBar
                            Grid.Row="1"
                            Margin="24,0,24,8"
                            CloseButtonCommand="{x:Bind ViewModel.DismissHistoryMessageCommand}"
                            IsOpen="{x:Bind ViewModel.HasHistoryMessage, Mode=OneWay}"
                            Message="{x:Bind ViewModel.HistoryMessage, Mode=OneWay}"
                            Severity="Warning"
                            Visibility="{x:Bind ViewModel.HasHistoryMessage, Mode=OneWay}" />

                        <ScrollViewer
                            Grid.Row="2"
                            Padding="8,0,8,8"
                            Visibility="{x:Bind ViewModel.HasHistory, Mode=OneWay}">
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.HistoryItems}">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:HistoryItemViewModel">
                                        <Grid
                                            Padding="16,8,8,8"
                                            AutomationProperties.Name="{x:Bind AutomationName}"
                                            ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="32" />
                                            </Grid.ColumnDefinitions>
                                            <Border
                                                Width="32"
                                                Height="32"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="{StaticResource ControlCornerRadius}">
                                                <FontIcon
                                                    AutomationProperties.AccessibilityView="Raw"
                                                    FontSize="16"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Glyph="{x:Bind Glyph}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock
                                                    Style="{StaticResource BodyTextBlockStyle}"
                                                    Text="{x:Bind Name}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="NoWrap" />
                                                <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind Summary}" />
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal"
                                                Spacing="4"
                                                Visibility="{x:Bind IsVerified}">
                                                <FontIcon
                                                    AutomationProperties.AccessibilityView="Raw"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                    Glyph="&#xE73E;" />
                                                <TextBlock
                                                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="Terverifikasi" />
                                            </StackPanel>
                                            <Button
                                                Grid.Column="3"
                                                Width="32"
                                                Height="32"
                                                Padding="0"
                                                AutomationProperties.Name="{x:Bind ShowInFolderName}"
                                                Command="{x:Bind ShowInFolderCommand}"
                                                Style="{StaticResource SubtleButtonStyle}"
                                                ToolTipService.ToolTip="Tampilkan di folder">
                                                <FontIcon FontSize="16" Glyph="&#xE838;" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </ScrollViewer>

                        <TextBlock
                            Grid.Row="2"
                            Margin="24,8,24,24"
                            Style="{StaticResource SecondaryBodyTextStyle}"
                            Text="{x:Bind ViewModel.HistoryEmptyText, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.HasNoHistory, Mode=OneWay}" />
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
