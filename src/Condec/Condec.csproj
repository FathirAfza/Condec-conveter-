<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(CondecWindowsTargetFramework)</TargetFramework>
    <TargetPlatformMinVersion>$(CondecWindowsMinVersion)</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>$(CondecWindowsMinVersion)</SupportedOSPlatformVersion>
    <RootNamespace>Condec</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Condec.ico</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <DefaultLanguage>id-ID</DefaultLanguage>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\*.png" />
    <Content Include="Assets\Condec.ico" />
    <!-- Shown by Settings → About → "Third-party licenses". -->
    <Content Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" />
  </ItemGroup>

  <!-- One version number: the package's. The assembly gets it too, so the portable build (no package) can show it. -->
  <Target Name="CondecVersionFromManifest" BeforeTargets="GetAssemblyVersion">
    <XmlPeek XmlInputPath="Package.appxmanifest" Query="/m:Package/m:Identity/@Version" Namespaces="&lt;Namespace Prefix='m' Uri='http://schemas.microsoft.com/appx/manifest/foundation/windows10' /&gt;">
      <Output TaskParameter="Result" PropertyName="Version" />
    </XmlPeek>
  </Target>

  <!-- Portable build (tools\publish-portable.ps1 passes WindowsPackageType=None): there is no package to
       carry the content, so publish copies it next to Condec.exe instead. -->
  <ItemDefinitionGroup Condition="'$(WindowsPackageType)' == 'None'">
    <Content>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemDefinitionGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!-- The LibreOffice copy from tools\fetch-libreoffice.ps1, packaged unmodified at LibreOffice\ so document
       conversion works without a separate install. Only the x64 build of LibreOffice is fetched so far. -->
  <ItemGroup Condition="'$(Platform)' == 'x64' and Exists('..\..\third_party\libreoffice\program\soffice.exe')">
    <Content Include="..\..\third_party\libreoffice\**" Link="LibreOffice\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The upscale models from tools\fetch-model.ps1 (Real-ESRGAN x4plus and Real-ESRNet x4plus as ONNX, BSD-3-Clause), at
       Models\<name>\model.onnx. Only the model files: nothing else that lands in third_party\models is packaged. -->
  <ItemGroup Condition="Exists('..\..\third_party\models\realesrgan-x4plus\model.onnx')">
    <Content Include="..\..\third_party\models\**\model.onnx" Link="Models\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The license and third-party notice files of ONNX Runtime and DirectML go with their DLLs (THIRD-PARTY-NOTICES.md §1). -->
  <ItemGroup>
    <Content Include="$(NuGetPackageRoot)microsoft.ml.onnxruntime.directml\$(CondecOnnxRuntimeVersion)\LICENSE" Link="Licenses\ONNXRuntime\LICENSE.txt" Condition="Exists('$(NuGetPackageRoot)microsoft.ml.onnxruntime.directml\$(CondecOnnxRuntimeVersion)\LICENSE')" />
    <Content Include="$(NuGetPackageRoot)microsoft.ml.onnxruntime.directml\$(CondecOnnxRuntimeVersion)\ThirdPartyNotices.txt" Link="Licenses\ONNXRuntime\ThirdPartyNotices.txt" Condition="Exists('$(NuGetPackageRoot)microsoft.ml.onnxruntime.directml\$(CondecOnnxRuntimeVersion)\ThirdPartyNotices.txt')" />
    <Content Include="$(NuGetPackageRoot)microsoft.ai.directml\$(CondecDirectMLVersion)\LICENSE.txt" Link="Licenses\DirectML\LICENSE.txt" Condition="Exists('$(NuGetPackageRoot)microsoft.ai.directml\$(CondecDirectMLVersion)\LICENSE.txt')" />
    <Content Include="$(NuGetPackageRoot)microsoft.ai.directml\$(CondecDirectMLVersion)\ThirdPartyNotices.txt" Link="Licenses\DirectML\ThirdPartyNotices.txt" Condition="Exists('$(NuGetPackageRoot)microsoft.ai.directml\$(CondecDirectMLVersion)\ThirdPartyNotices.txt')" />
  </ItemGroup>

  <!-- ONNX Runtime and DirectML bring files that are only for people who build against them (the import library, and the
       DirectML debug layer with the symbol files, about 15 MB). The app loads none of them. -->
  <Target Name="TrimDevelopmentOnlyNativeFiles" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <_DevOnlyFile Include="@(Content);@(None);@(ReferenceCopyLocalPaths);@(RuntimeTargetsCopyLocalItems)" Condition="'%(Filename)%(Extension)' == 'DirectML.Debug.dll' or '%(Filename)%(Extension)' == 'DirectML.Debug.pdb' or '%(Filename)%(Extension)' == 'DirectML.pdb' or '%(Filename)%(Extension)' == 'onnxruntime.lib'" />
      <Content Remove="@(_DevOnlyFile)" />
      <None Remove="@(_DevOnlyFile)" />
      <ReferenceCopyLocalPaths Remove="@(_DevOnlyFile)" />
      <RuntimeTargetsCopyLocalItems Remove="@(_DevOnlyFile)" />
    </ItemGroup>
  </Target>

  <Target Name="TrimDevelopmentOnlyNativeFilesFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_DevOnlyPublishFile Include="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'DirectML.Debug.dll' or '%(Filename)%(Extension)' == 'DirectML.Debug.pdb' or '%(Filename)%(Extension)' == 'DirectML.pdb' or '%(Filename)%(Extension)' == 'onnxruntime.lib'" />
      <ResolvedFileToPublish Remove="@(_DevOnlyPublishFile)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!-- Framework-dependent: the Windows App SDK runtime is a system framework package, not bundled. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Condec.Core\Condec.Core.csproj" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK NuGet
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Trimming stays off until it can be verified on Windows (WinUI and reflection pitfalls). -->
    <PublishTrimmed>False</PublishTrimmed>
    <GenerateAppInstallerFile>False</GenerateAppInstallerFile>
    <AppxBundle>Never</AppxBundle>
    <!-- No update checks: Condec never touches the network. -->
    <HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
    <AppxLogTelemetryFromSideloadingScript>false</AppxLogTelemetryFromSideloadingScript>
  </PropertyGroup>

</Project>
