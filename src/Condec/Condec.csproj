<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(CondecWindowsTargetFramework)</TargetFramework>
    <TargetPlatformMinVersion>$(CondecWindowsMinVersion)</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>$(CondecWindowsMinVersion)</SupportedOSPlatformVersion>
    <RootNamespace>Condec</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Condec.ico</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <DefaultLanguage>id-ID</DefaultLanguage>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\*.png" />
    <Content Include="Assets\Condec.ico" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!-- The LibreOffice copy from tools\fetch-libreoffice.ps1, packaged unmodified at LibreOffice\ so document
       conversion works without a separate install. Only the x64 build of LibreOffice is fetched so far. -->
  <ItemGroup Condition="'$(Platform)' == 'x64' and Exists('..\..\third_party\libreoffice\program\soffice.exe')">
    <Content Include="..\..\third_party\libreoffice\**" Link="LibreOffice\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Framework-dependent: the Windows App SDK runtime is a system framework package, not bundled. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Condec.Core\Condec.Core.csproj" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK NuGet
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Trimming stays off until it can be verified on Windows (WinUI and reflection pitfalls). -->
    <PublishTrimmed>False</PublishTrimmed>
    <GenerateAppInstallerFile>False</GenerateAppInstallerFile>
    <AppxBundle>Never</AppxBundle>
    <!-- No update checks: Condec never touches the network. -->
    <HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
    <AppxLogTelemetryFromSideloadingScript>false</AppxLogTelemetryFromSideloadingScript>
  </PropertyGroup>

</Project>
