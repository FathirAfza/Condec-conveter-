<?xml version="1.0" encoding="utf-8"?>
<!--  Settings (DESIGN §6.4): two tabs of setting rows. Every value goes through AppSettings.  -->
<Page
    x:Class="Condec.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Condec"
    xmlns:vm="using:Condec.ViewModels"
    NavigationCacheMode="Required">

    <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Disabled">
        <StackPanel
            x:Name="Column"
            Margin="40,28,40,32"
            HorizontalAlignment="Left">
            <TextBlock
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource TitleTextBlockStyle}"
                local:L.Text="Page.Settings.Title" />
            <TextBlock
                Margin="0,4,0,0"
                Style="{StaticResource SecondaryBodyTextStyle}"
                local:L.Text="Page.Settings.Subtitle" />

            <SelectorBar
                x:Name="Tabs"
                Margin="0,20,0,0"
                SelectionChanged="OnTabChanged">
                <SelectorBarItem x:Name="RenderTab" IsSelected="True" local:L.Text="Settings.TabRender" />
                <SelectorBarItem x:Name="GeneralTab" local:L.Text="Settings.TabGeneral" />
            </SelectorBar>

            <!--  ===== Render and performance =====  -->
            <StackPanel x:Name="RenderPanel" Spacing="4">

                <TextBlock Style="{StaticResource SettingGroupTextStyle}" local:L.Text="Settings.GroupDevice" />
                <Border Padding="20" Style="{StaticResource CardBorderStyle}">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid ColumnSpacing="24" RowSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Spacing="2">
                                <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" local:L.Text="Settings.Cpu" />
                                <TextBlock
                                    IsTextSelectionEnabled="True"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="{x:Bind ViewModel.CpuText}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" local:L.Text="Settings.Ram" />
                                <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind ViewModel.RamText}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Spacing="2">
                                <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" local:L.Text="Settings.Gpu" />
                                <TextBlock
                                    IsTextSelectionEnabled="True"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="{x:Bind ViewModel.GpuText}" />
                                <TextBlock
                                    Style="{StaticResource SecondaryCaptionTextStyle}"
                                    Text="{x:Bind ViewModel.GpuDetail}"
                                    Visibility="{x:Bind ViewModel.HasGpuDetail}" />
                            </StackPanel>
                            <StackPanel
                                Grid.Row="1"
                                Grid.Column="1"
                                Spacing="2">
                                <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" local:L.Text="Settings.Npu" />
                                <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind ViewModel.NpuText}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel
                            Grid.Column="1"
                            MinWidth="120"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" local:L.Text="Settings.DeviceLimit" />
                            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind ViewModel.DeviceScaleLimitText}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  Render mode: the header shows the choice, the body lists the engines with their devices.  -->
                <Expander
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    local:L.AutomationName="Settings.RenderMode">
                    <Expander.Header>
                        <Grid Padding="0,12" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Style="{StaticResource BodyTextBlockStyle}" local:L.Text="Settings.RenderMode" />
                                <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" local:L.Text="Settings.RenderModeDescription" />
                            </StackPanel>
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind ViewModel.RenderModeText, Mode=OneWay}" />
                        </Grid>
                    </Expander.Header>
                    <RadioButtons local:L.AutomationName="Settings.RenderMode" SelectedIndex="{x:Bind ViewModel.RenderModeIndex, Mode=TwoWay}">
                        <RadioButton AutomationProperties.Name="{x:Bind ViewModel.GpuEngineSpoken}" IsEnabled="{x:Bind ViewModel.HasGpu}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind ViewModel.GpuEngineText}" />
                                <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind ViewModel.GpuEngineStatus}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton AutomationProperties.Name="{x:Bind ViewModel.CpuEngineSpoken}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind ViewModel.CpuEngineText}" />
                                <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind ViewModel.CpuEngineStatus}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton AutomationProperties.Name="{x:Bind ViewModel.NpuEngineSpoken}" IsEnabled="{x:Bind ViewModel.HasNpu}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind ViewModel.NpuEngineText}" />
                                <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind ViewModel.NpuEngineStatus}" />
                            </StackPanel>
                        </RadioButton>
                    </RadioButtons>
                </Expander>

                <!--  Performance mode  -->
                <Border Style="{StaticResource SettingRowBorderStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Style="{StaticResource BodyTextBlockStyle}" local:L.Text="Settings.PerformanceMode" />
                            <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind ViewModel.PerformanceModeDescription, Mode=OneWay}" />
                        </StackPanel>
                        <ComboBox
                            Grid.Column="1"
                            Width="200"
                            VerticalAlignment="Center"
                            local:L.AutomationName="Settings.PerformanceMode"
                            IsEnabled="{x:Bind ViewModel.CanChoosePerformanceMode, Mode=OneWay}"
                            ItemsSource="{x:Bind ViewModel.PerformanceModeOptions}"
                            SelectedIndex="{x:Bind ViewModel.PerformanceModeIndex, Mode=TwoWay}" />
                    </Grid>
                </Border>

                <!--  Memory saver  -->
                <Border Style="{StaticResource SettingRowBorderStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Style="{StaticResource BodyTextBlockStyle}" local:L.Text="Settings.MemorySaver" />
                            <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" local:L.Text="Settings.MemorySaverDescription" />
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="1"
                            MinWidth="0"
                            local:L.AutomationName="Settings.MemorySaver"
                            IsOn="{x:Bind ViewModel.MemorySaver, Mode=TwoWay}"
                            local:L.OffContent="Settings.Off"
                            local:L.OnContent="Settings.On" />
                    </Grid>
                </Border>

                <!--  Upscale limit  -->
                <Border Style="{StaticResource SettingRowBorderStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Style="{StaticResource BodyTextBlockStyle}" local:L.Text="Settings.ScaleLimit" />
                            <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind ViewModel.ScaleLimitDescription}" />
                        </StackPanel>
                        <ComboBox
                            Grid.Column="1"
                            Width="160"
                            VerticalAlignment="Center"
                            local:L.AutomationName="Settings.ScaleLimit"
                            ItemsSource="{x:Bind ViewModel.ScaleLimitOptions}"
                            SelectedItem="{x:Bind ViewModel.SelectedScaleLimit, Mode=TwoWay}"
                            SelectionChanged="OnScaleLimitChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ScaleLimitOption">
                                    <Grid ColumnSpacing="12" Opacity="{x:Bind DisplayOpacity}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Text}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource SecondaryCaptionTextStyle}"
                                            Text="{x:Bind Caption}"
                                            TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                </Border>

                <!--  Memory limit  -->
                <Border Style="{StaticResource SettingRowBorderStyle}">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Style="{StaticResource BodyTextBlockStyle}" local:L.Text="Settings.MemoryLimit" />
                                <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind ViewModel.MemoryLimitDescription, Mode=OneWay}" />
                            </StackPanel>
                            <Slider
                                Grid.Column="1"
                                Width="220"
                                VerticalAlignment="Center"
                                local:L.AutomationName="Settings.MemoryLimitSpoken"
                                IsEnabled="{x:Bind ViewModel.CanChooseMemoryLimit, Mode=OneWay}"
                                Maximum="{x:Bind ViewModel.MemoryMaximum}"
                                Minimum="{x:Bind ViewModel.MemoryMinimum}"
                                StepFrequency="1"
                                TickFrequency="4"
                                TickPlacement="BottomRight"
                                Value="{x:Bind ViewModel.MemoryLimitGb, Mode=TwoWay}" />
                            <TextBlock
                                Grid.Column="2"
                                MinWidth="48"
                                VerticalAlignment="Center"
                                HorizontalTextAlignment="Right"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind ViewModel.MemoryLimitText, Mode=OneWay}" />
                        </Grid>
                        <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind ViewModel.RamRequirementText}" />
                    </StackPanel>
                </Border>

                <!--  Render dump  -->
                <Border Style="{StaticResource SettingRowBorderStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Style="{StaticResource BodyTextBlockStyle}" local:L.Text="Settings.Cache" />
                            <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind ViewModel.CacheDescription, Mode=OneWay}" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Command="{x:Bind ViewModel.ClearCacheCommand}"
                            local:L.Content="Settings.CacheClear" />
                    </Grid>
                </Border>
            </StackPanel>

            <!--  ===== General =====  -->
            <StackPanel
                x:Name="GeneralPanel"
                Spacing="4"
                Visibility="Collapsed">

                <InfoBar
                    Margin="0,16,0,0"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasGeneralMessage, Mode=OneWay}"
                    Message="{x:Bind ViewModel.GeneralMessage, Mode=OneWay}"
                    Severity="Informational"
                    Visibility="{x:Bind ViewModel.HasGeneralMessage, Mode=OneWay}" />

                <TextBlock Style="{StaticResource SettingGroupTextStyle}" local:L.Text="Settings.GroupAppearance" />

                <Border Style="{StaticResource SettingRowBorderStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyTextBlockStyle}"
                            local:L.Text="Settings.Theme" />
                        <ComboBox
                            Grid.Column="1"
                            Width="160"
                            VerticalAlignment="Center"
                            local:L.AutomationName="Settings.Theme"
                            SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                            <ComboBoxItem local:L.Content="Settings.ThemeLight" />
                            <ComboBoxItem local:L.Content="Settings.ThemeDark" />
                            <ComboBoxItem local:L.Content="Settings.ThemeSystem" />
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingRowBorderStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Style="{StaticResource BodyTextBlockStyle}" local:L.Text="Settings.Mica" />
                            <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" local:L.Text="Settings.MicaDescription" />
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="1"
                            MinWidth="0"
                            local:L.AutomationName="Settings.Mica"
                            IsOn="{x:Bind ViewModel.MicaEnabled, Mode=TwoWay}"
                            local:L.OffContent="Settings.Off"
                            local:L.OnContent="Settings.On" />
                    </Grid>
                </Border>

                <TextBlock Style="{StaticResource SettingGroupTextStyle}" local:L.Text="Settings.GroupLog" />

                <Border Style="{StaticResource SettingRowBorderStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Style="{StaticResource BodyTextBlockStyle}" local:L.Text="Settings.LogEnabled" />
                            <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" local:L.Text="Settings.LogEnabledDescription" />
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="1"
                            MinWidth="0"
                            local:L.AutomationName="Settings.LogEnabled"
                            IsOn="{x:Bind ViewModel.LogEnabled, Mode=TwoWay}"
                            local:L.OffContent="Settings.Off"
                            local:L.OnContent="Settings.On" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingRowBorderStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Style="{StaticResource BodyTextBlockStyle}" local:L.Text="Settings.LogLevel" />
                            <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" local:L.Text="Settings.LogLevelDescription" />
                        </StackPanel>
                        <ComboBox
                            Grid.Column="1"
                            Width="160"
                            VerticalAlignment="Center"
                            local:L.AutomationName="Settings.LogLevel"
                            IsEnabled="{x:Bind ViewModel.LogEnabled, Mode=OneWay}"
                            SelectedIndex="{x:Bind ViewModel.LogLevelIndex, Mode=TwoWay}">
                            <ComboBoxItem local:L.Content="Settings.LogLevelError" />
                            <ComboBoxItem local:L.Content="Settings.LogLevelInfo" />
                            <ComboBoxItem local:L.Content="Settings.LogLevelDebug" />
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingRowBorderStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Style="{StaticResource BodyTextBlockStyle}" local:L.Text="Settings.LogFolder" />
                            <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" local:L.Text="Settings.LogFolderDescription" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button Command="{x:Bind ViewModel.OpenLogFolderCommand}" local:L.Content="Settings.LogOpenFolder" />
                            <Button Command="{x:Bind ViewModel.ClearLogsCommand}" local:L.Content="Settings.LogClear" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Style="{StaticResource SettingGroupTextStyle}" local:L.Text="Settings.GroupAbout" />

                <Border Style="{StaticResource SettingRowBorderStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.VersionText}" />
                            <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" local:L.Text="Settings.AboutDescription" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Command="{x:Bind ViewModel.OpenLicensesCommand}"
                            local:L.Content="Settings.Licenses" />
                    </Grid>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
