<?xml version="1.0" encoding="utf-8"?>
<!--  The converter card of DESIGN §6.1 (input, processing, done, failed) of Convert File.  -->
<UserControl
    x:Class="Condec.Views.ConverterCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Condec"
    xmlns:views="using:Condec.Views"
    xmlns:vm="using:Condec.ViewModels">

    <Border
        Padding="24"
        Style="{StaticResource CardBorderStyle}">
        <Grid>

            <!--  Input  -->
            <Grid Visibility="{x:Bind ViewModel.IsInput, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <InfoBar
                    Margin="0,0,0,20"
                    CloseButtonCommand="{x:Bind ViewModel.DismissInputMessageCommand}"
                    IsOpen="{x:Bind ViewModel.HasInputMessage, Mode=OneWay}"
                    Message="{x:Bind ViewModel.InputMessage, Mode=OneWay}"
                    Severity="{x:Bind ViewModel.InputMessageSeverity, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.HasInputMessage, Mode=OneWay}" />

                <Grid Grid.Row="1" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  Source file panel, also the drop target.  -->
                    <Grid
                        Height="168"
                        AllowDrop="True"
                        DragOver="OnSourceDragOver"
                        Drop="OnSourceDrop">
                        <Grid Visibility="{x:Bind ViewModel.HasNoSource, Mode=OneWay}">
                            <Rectangle
                                Fill="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                RadiusX="8"
                                RadiusY="8"
                                Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                                StrokeDashArray="4,3"
                                StrokeThickness="1" />
                            <StackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="8">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    AutomationProperties.AccessibilityView="Raw"
                                    FontSize="32"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Glyph="&#xE898;" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    local:L.Text="Input.DropHere" />
                                <Button
                                    x:Name="PickFileButton"
                                    HorizontalAlignment="Center"
                                    Command="{x:Bind ViewModel.PickSourceCommand}"
                                    local:L.Content="Input.Choose" />
                            </StackPanel>
                        </Grid>

                        <Border
                            Padding="24"
                            Style="{StaticResource InnerPanelBorderStyle}"
                            Visibility="{x:Bind ViewModel.HasSource, Mode=OneWay}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    VerticalAlignment="Center"
                                    AutomationProperties.AccessibilityView="Raw"
                                    FontSize="40"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="{x:Bind ViewModel.Source.Glyph, Mode=OneWay, FallbackValue=''}" />
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="2">
                                    <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" local:L.Text="Source.Label" />
                                    <TextBlock
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind ViewModel.Source.Name, Mode=OneWay, FallbackValue=''}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.Source.Path, Mode=OneWay, FallbackValue=''}" />
                                    <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind ViewModel.Source.Description, Mode=OneWay, FallbackValue=''}" />
                                </StackPanel>
                                <HyperlinkButton
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    local:L.AutomationName="Source.ChangeSpoken"
                                    Command="{x:Bind ViewModel.PickSourceCommand}"
                                    local:L.Content="Source.Change" />
                            </Grid>
                        </Border>
                    </Grid>

                    <FontIcon
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        AutomationProperties.AccessibilityView="Raw"
                        FontSize="24"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE72A;" />

                    <!--  Target format panel  -->
                    <Border
                        Grid.Column="2"
                        Height="168"
                        Padding="24"
                        Style="{StaticResource InnerPanelBorderStyle}">
                        <StackPanel VerticalAlignment="Center" Spacing="8">
                            <ComboBox
                                x:Name="FormatComboBox"
                                SelectionChanged="FormatComboBox_SelectionChanged"
                                HorizontalAlignment="Stretch"
                                local:L.Header="Format.Header"
                                IsEnabled="{x:Bind ViewModel.HasSource, Mode=OneWay}"
                                ItemsSource="{x:Bind ViewModel.TargetOptions}"
                                PlaceholderText="{x:Bind ViewModel.FormatPlaceholder, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.SelectedTarget, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FormatOption">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind DisplayName}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource SecondaryCaptionTextStyle}"
                                                Text="{x:Bind Caption}" />
                                        </Grid>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind ViewModel.FormatHelpText, Mode=OneWay}" />
                            <!--  DESIGN §6.1: DXF and DWG are made in Architecture.  -->
                            <HyperlinkButton
                                Padding="0,4"
                                Command="{x:Bind ViewModel.OpenArchitectureCommand}"
                                local:L.Content="Format.ArchitectureLink" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!--  Audio quality and video size, for the targets that have them (DESIGN §6.1.2).  -->
                <Grid
                    Grid.Row="2"
                    Margin="0,20,0,0"
                    ColumnSpacing="16"
                    Visibility="{x:Bind ViewModel.ShowsMediaOptions, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox
                        HorizontalAlignment="Stretch"
                        local:L.Header="Media.AudioQualityHeader"
                        ItemsSource="{x:Bind ViewModel.Media.AudioChoices}"
                        SelectedItem="{x:Bind ViewModel.Media.SelectedAudio, Mode=TwoWay}"
                        Visibility="{x:Bind ViewModel.ShowsAudioQuality, Mode=OneWay}" />
                    <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.ShowsVideoSize, Mode=OneWay}">
                        <ComboBox
                            HorizontalAlignment="Stretch"
                            local:L.Header="Media.VideoSizeHeader"
                            ItemsSource="{x:Bind ViewModel.Media.VideoChoices}"
                            SelectedItem="{x:Bind ViewModel.Media.SelectedVideo, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" local:L.Text="Media.VideoSizeHelp" />
                    </StackPanel>
                </Grid>

                <!--  PDF options: the page, for an image target.  -->
                <Grid
                    Grid.Row="2"
                    Margin="0,20,0,0"
                    ColumnSpacing="16"
                    Visibility="{x:Bind ViewModel.ShowsPageChoice, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox
                        HorizontalAlignment="Stretch"
                        local:L.Header="Cad.PageHeader"
                        ItemsSource="{x:Bind ViewModel.Pdf.Pages, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.Pdf.SelectedPage, Mode=TwoWay}" />
                </Grid>

                <Grid
                    Grid.Row="3"
                    Margin="0,20,0,0"
                    ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <FontIcon
                            AutomationProperties.AccessibilityView="Raw"
                            FontSize="16"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xEA18;" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryCaptionTextStyle}"
                            local:L.Text="Privacy.Note" />
                    </StackPanel>
                    <Button
                        x:Name="ConvertButton"
                        Grid.Column="1"
                        Command="{x:Bind ViewModel.ConvertCommand}"
                        local:L.Content="Convert.Label"
                        Style="{StaticResource AccentButtonStyle}" />
                </Grid>
            </Grid>

            <!--  Processing  -->
            <StackPanel Spacing="20" Visibility="{x:Bind ViewModel.IsProcessing, Mode=OneWay}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="{x:Bind ViewModel.ProcessingTitle, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                        <TextBlock
                            Style="{StaticResource SecondaryCaptionTextStyle}"
                            Text="{x:Bind ViewModel.ProcessingCaption, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                    </StackPanel>
                    <Button
                        x:Name="CancelButton"
                        Grid.Column="1"
                        VerticalAlignment="Top"
                        Command="{x:Bind ViewModel.CancelCommand}"
                        local:L.Content="Processing.Cancel">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Escape" />
                        </Button.KeyboardAccelerators>
                    </Button>
                </Grid>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar
                        VerticalAlignment="Center"
                        local:L.AutomationName="Processing.ProgressSpoken"
                        Maximum="100"
                        Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}" />
                    <TextBlock
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" />
                </Grid>

                <ItemsControl IsTabStop="False" ItemsSource="{x:Bind ViewModel.Steps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ConversionStepViewModel">
                            <Grid
                                Height="40"
                                AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}"
                                ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid
                                    Width="20"
                                    Height="20"
                                    Visibility="{x:Bind IsDone, Mode=OneWay}">
                                    <Ellipse Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                                    <FontIcon
                                        AutomationProperties.AccessibilityView="Raw"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                        Glyph="&#xE73E;" />
                                </Grid>
                                <ProgressRing
                                    Width="20"
                                    Height="20"
                                    IsActive="{x:Bind IsActive, Mode=OneWay}"
                                    Visibility="{x:Bind IsActive, Mode=OneWay}" />
                                <Ellipse
                                    Width="18"
                                    Height="18"
                                    Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                                    StrokeThickness="1"
                                    Visibility="{x:Bind IsWaiting, Mode=OneWay}" />

                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Style="{x:Bind views:ConverterCard.StepLabelStyle(State), Mode=OneWay}"
                                    Text="{x:Bind Label}" />
                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SecondaryCaptionTextStyle}"
                                    Text="{x:Bind Detail, Mode=OneWay}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!--  Done  -->
            <StackPanel Spacing="20" Visibility="{x:Bind ViewModel.IsDone, Mode=OneWay}">
                <InfoBar
                    IsClosable="False"
                    IsOpen="True"
                    local:L.Message="Done.Message"
                    Severity="Success"
                    local:L.Title="Done.Title" />
                <Grid ColumnSpacing="16" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource SecondaryBodyTextStyle}" local:L.Text="Done.Location" />
                    <TextBlock
                        Grid.Column="1"
                        IsTextSelectionEnabled="True"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="{x:Bind ViewModel.Result.OutputPath, Mode=OneWay, FallbackValue=''}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap"
                        ToolTipService.ToolTip="{x:Bind ViewModel.Result.OutputPath, Mode=OneWay, FallbackValue=''}" />
                    <TextBlock
                        Grid.Row="1"
                        Style="{StaticResource SecondaryBodyTextStyle}"
                        local:L.Text="Done.Format" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="1"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="{x:Bind ViewModel.ConversionFormat, Mode=OneWay}" />
                    <TextBlock
                        Grid.Row="2"
                        Style="{StaticResource SecondaryBodyTextStyle}"
                        local:L.Text="Done.Integrity" />
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="1"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="{x:Bind ViewModel.ResultIntegrity, Mode=OneWay}" />
                </Grid>
                <StackPanel>
                    <ItemsControl IsTabStop="False" ItemsSource="{x:Bind ViewModel.ResultNotes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ResultNoteItem">
                                <InfoBar
                                    Margin="0,0,0,20"
                                    IsClosable="False"
                                    IsOpen="True"
                                    Message="{x:Bind Message}"
                                    Severity="{x:Bind Severity}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <InfoBar
                        Margin="0,0,0,20"
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.HasResultMessage, Mode=OneWay}"
                        Message="{x:Bind ViewModel.ResultMessage, Mode=OneWay}"
                        Severity="Warning"
                        Visibility="{x:Bind ViewModel.HasResultMessage, Mode=OneWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="OpenResultButton"
                            Command="{x:Bind ViewModel.OpenResultCommand}"
                            local:L.Content="Done.OpenFile"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button Command="{x:Bind ViewModel.ShowResultInFolderCommand}" local:L.Content="Done.ShowInFolder" />
                        <HyperlinkButton Command="{x:Bind ViewModel.ConvertAnotherCommand}" local:L.Content="Done.ConvertAnother" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!--  Failed  -->
            <StackPanel Spacing="20" Visibility="{x:Bind ViewModel.IsFailed, Mode=OneWay}">
                <InfoBar
                    IsClosable="False"
                    IsOpen="True"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    Severity="Error"
                    local:L.Title="Failed.Title" />
                <Grid ColumnSpacing="16" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource SecondaryBodyTextStyle}" local:L.Text="Failed.File" />
                    <TextBlock
                        Grid.Column="1"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="{x:Bind ViewModel.Source.Name, Mode=OneWay, FallbackValue=''}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                    <TextBlock
                        Grid.Row="1"
                        Style="{StaticResource SecondaryBodyTextStyle}"
                        local:L.Text="Done.Format" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="1"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="{x:Bind ViewModel.ConversionFormat, Mode=OneWay}" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        x:Name="RetryButton"
                        Command="{x:Bind ViewModel.RetryCommand}"
                        local:L.Content="Failed.TryAgain"
                        Style="{StaticResource AccentButtonStyle}" />
                    <Button Command="{x:Bind ViewModel.BackToInputCommand}" local:L.Content="Failed.ChangeChoice" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
