<?xml version="1.0" encoding="utf-8"?>
<!--  Architecture (DESIGN §6.3): two directions, one tab each.  -->
<Page
    x:Class="Condec.Views.ArchitecturePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Condec"
    xmlns:views="using:Condec.Views"
    NavigationCacheMode="Required">

    <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Disabled">
        <StackPanel
            x:Name="Column"
            Margin="40,28,40,32"
            HorizontalAlignment="Left">
            <TextBlock
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource TitleTextBlockStyle}"
                local:L.Text="Page.Architecture.Title" />
            <TextBlock
                Margin="0,4,0,0"
                Style="{StaticResource SecondaryBodyTextStyle}"
                local:L.Text="Page.Architecture.Subtitle" />

            <SelectorBar
                x:Name="Tabs"
                Margin="0,20,0,16"
                SelectionChanged="OnTabChanged">
                <SelectorBarItem x:Name="ToCadTab" IsSelected="True" local:L.Text="Architecture.TabToCad" />
                <SelectorBarItem x:Name="FromCadTab" local:L.Text="Architecture.TabFromCad" />
            </SelectorBar>

            <views:ToCadView x:Name="ToCad" />
            <views:FromCadView x:Name="FromCad" Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>
</Page>
