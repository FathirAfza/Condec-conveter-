<?xml version="1.0" encoding="utf-8"?>
<!--  Upscale Image (DESIGN §6.2): the picture and the size of the result, the estimate, then the progress and the result.  -->
<Page
    x:Class="Condec.Views.UpscalePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Condec"
    xmlns:views="using:Condec.Views"
    xmlns:vm="using:Condec.ViewModels"
    NavigationCacheMode="Required">

    <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Disabled">
        <StackPanel
            x:Name="Column"
            Margin="40,28,40,32"
            HorizontalAlignment="Left">
            <TextBlock
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource TitleTextBlockStyle}"
                local:L.Text="Page.Upscale.Title" />
            <TextBlock
                Margin="0,4,0,0"
                Style="{StaticResource SecondaryBodyTextStyle}"
                local:L.Text="Page.Upscale.Subtitle" />

            <!--  The model is missing or damaged: nothing can be upscaled.  -->
            <InfoBar
                Margin="0,20,0,0"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasModelProblem, Mode=OneWay}"
                Message="{x:Bind ViewModel.ModelProblem, Mode=OneWay}"
                Severity="Error"
                Visibility="{x:Bind ViewModel.HasModelProblem, Mode=OneWay}"
                local:L.Title="Upscale.ModelProblemTitle" />

            <!--  Upscale tidak tersedia: the limit of this device for this picture is below 1.5x.  -->
            <InfoBar
                Margin="0,20,0,0"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.IsLimitUnavailable, Mode=OneWay}"
                Message="{x:Bind ViewModel.UnavailableMessage, Mode=OneWay}"
                Severity="Error"
                Visibility="{x:Bind ViewModel.IsLimitUnavailable, Mode=OneWay}"
                local:L.Title="Upscale.UnavailableTitle" />

            <!--  Input  -->
            <StackPanel Margin="0,20,0,0" Visibility="{x:Bind ViewModel.IsInput, Mode=OneWay}">
                <InfoBar
                    Margin="0,0,0,16"
                    CloseButtonCommand="{x:Bind ViewModel.DismissInputMessageCommand}"
                    IsOpen="{x:Bind ViewModel.HasInputMessage, Mode=OneWay}"
                    Message="{x:Bind ViewModel.InputMessage, Mode=OneWay}"
                    Severity="{x:Bind ViewModel.InputMessageSeverity, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.HasInputMessage, Mode=OneWay}" />

                <!--  No picture yet: the drop target.  -->
                <Border
                    Padding="24"
                    Style="{StaticResource CardBorderStyle}"
                    Visibility="{x:Bind ViewModel.HasNoSource, Mode=OneWay}">
                    <Grid
                        Height="168"
                        AllowDrop="True"
                        DragOver="OnSourceDragOver"
                        Drop="OnSourceDrop">
                        <Rectangle
                            Fill="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            RadiusX="8"
                            RadiusY="8"
                            Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                            StrokeDashArray="4,3"
                            StrokeThickness="1" />
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8">
                            <FontIcon
                                HorizontalAlignment="Center"
                                AutomationProperties.AccessibilityView="Raw"
                                FontSize="32"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE898;" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Style="{StaticResource BodyTextBlockStyle}"
                                local:L.Text="Upscale.DropHere" />
                            <Button
                                x:Name="PickFileButton"
                                HorizontalAlignment="Center"
                                Command="{x:Bind ViewModel.PickSourceCommand}"
                                local:L.Content="Upscale.Choose" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  A picture is chosen: the diagram and the choices side by side, then the estimate.  -->
                <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.HasSource, Mode=OneWay}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="380" />
                        </Grid.ColumnDefinitions>

                        <!--  Left card: the picture and the size diagram  -->
                        <Border
                            Padding="24"
                            Style="{StaticResource CardBorderStyle}">
                            <Grid
                                AllowDrop="True"
                                DragOver="OnSourceDragOver"
                                Drop="OnSourceDrop"
                                RowSpacing="16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        VerticalAlignment="Center"
                                        AutomationProperties.AccessibilityView="Raw"
                                        FontSize="32"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="{x:Bind ViewModel.Source.Glyph, Mode=OneWay, FallbackValue=''}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="{x:Bind ViewModel.Source.Name, Mode=OneWay, FallbackValue=''}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap"
                                            ToolTipService.ToolTip="{x:Bind ViewModel.Source.Path, Mode=OneWay, FallbackValue=''}" />
                                        <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind ViewModel.SourceCaption, Mode=OneWay}" />
                                    </StackPanel>
                                    <HyperlinkButton
                                        x:Name="ChangeFileButton"
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        local:L.AutomationName="Source.ChangeSpoken"
                                        Command="{x:Bind ViewModel.PickSourceCommand}"
                                        local:L.Content="Source.Change" />
                                </Grid>

                                <!--  The result is the dashed box; the original, drawn small in its corner, is 100 / scale percent of it.  -->
                                <Grid
                                    x:Name="DiagramArea"
                                    Grid.Row="1"
                                    MinHeight="200"
                                    AutomationProperties.Name="{x:Bind ViewModel.DiagramText, Mode=OneWay}"
                                    SizeChanged="OnDiagramSizeChanged">
                                    <Grid
                                        x:Name="DiagramFrame"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                        <Rectangle
                                            Fill="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            RadiusX="4"
                                            RadiusY="4"
                                            Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                                            StrokeDashArray="4,3"
                                            StrokeThickness="1" />
                                        <Border
                                            x:Name="OriginalBox"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                            CornerRadius="2" />
                                    </Grid>
                                </Grid>

                                <StackPanel
                                    Grid.Row="2"
                                    Orientation="Horizontal"
                                    Spacing="24">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border
                                            Width="12"
                                            Height="12"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                            CornerRadius="2" />
                                        <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind ViewModel.OriginalLegend, Mode=OneWay}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Rectangle
                                            Width="12"
                                            Height="12"
                                            VerticalAlignment="Center"
                                            RadiusX="2"
                                            RadiusY="2"
                                            Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                                            StrokeDashArray="2,1.5"
                                            StrokeThickness="1" />
                                        <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind ViewModel.ResultLegend, Mode=OneWay}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!--  Right card: engine, scale, percentage, resolution, format  -->
                        <Border
                            Grid.Column="1"
                            Padding="24"
                            Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="16">
                                <StackPanel Spacing="2">
                                    <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" local:L.Text="Upscale.Engine" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="{x:Bind ViewModel.EngineText, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap"
                                            ToolTipService.ToolTip="{x:Bind ViewModel.EngineText, Mode=OneWay}" />
                                        <HyperlinkButton
                                            Grid.Column="1"
                                            Command="{x:Bind ViewModel.OpenSettingsCommand}"
                                            local:L.Content="Upscale.EngineChange" />
                                    </Grid>
                                    <TextBlock
                                        Style="{StaticResource SecondaryCaptionTextStyle}"
                                        Text="{x:Bind ViewModel.EngineNote, Mode=OneWay}"
                                        TextWrapping="WrapWholeWords"
                                        Visibility="{x:Bind ViewModel.HasEngineNote, Mode=OneWay}" />
                                </StackPanel>

                                <ContentControl
                                    HorizontalContentAlignment="Stretch"
                                    IsEnabled="{x:Bind ViewModel.CanChoose, Mode=OneWay}"
                                    IsTabStop="False">
                                <StackPanel Spacing="16">
                                    <ComboBox
                                        x:Name="ScaleComboBox"
                                        HorizontalAlignment="Stretch"
                                        ItemsSource="{x:Bind ViewModel.ScaleChoices}"
                                        PlaceholderText="{x:Bind ViewModel.ScalePlaceholder, Mode=OneWay}"
                                        SelectedItem="{x:Bind ViewModel.SelectedScaleChoice, Mode=TwoWay}"
                                        local:L.Header="Upscale.Scale">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ScaleChoice">
                                                <Grid ColumnSpacing="16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{x:Bind Label}" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Style="{StaticResource SecondaryCaptionTextStyle}"
                                                        Text="{x:Bind Caption}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <StackPanel Spacing="0">
                                        <Grid>
                                            <TextBlock Style="{StaticResource BodyTextBlockStyle}" local:L.Text="Upscale.Percent" />
                                            <TextBlock
                                                HorizontalAlignment="Right"
                                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                                Text="{x:Bind ViewModel.PercentText, Mode=OneWay}" />
                                        </Grid>
                                        <Slider
                                            x:Name="ScaleSlider"
                                            Minimum="{x:Bind ViewModel.SliderMinimum, Mode=OneWay}"
                                            Maximum="{x:Bind ViewModel.SliderMaximum, Mode=OneWay}"
                                            StepFrequency="50"
                                            TickFrequency="50"
                                            TickPlacement="BottomRight"
                                            Value="{x:Bind ViewModel.SliderValue, Mode=TwoWay}"
                                            local:L.AutomationName="Upscale.Percent" />
                                        <Grid>
                                            <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind ViewModel.SliderMinimumText, Mode=OneWay}" />
                                            <TextBlock
                                                HorizontalAlignment="Right"
                                                Style="{StaticResource SecondaryCaptionTextStyle}"
                                                Text="{x:Bind ViewModel.SliderMaximumText, Mode=OneWay}" />
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        Visibility="{x:Bind ViewModel.HasLockedText, Mode=OneWay}">
                                        <FontIcon
                                            VerticalAlignment="Top"
                                            AutomationProperties.AccessibilityView="Raw"
                                            FontSize="14"
                                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                            Glyph="&#xE72E;" />
                                        <TextBlock
                                            MaxWidth="308"
                                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind ViewModel.LockedText, Mode=OneWay}"
                                            TextWrapping="WrapWholeWords" />
                                    </StackPanel>

                                    <ComboBox
                                        x:Name="ResolutionComboBox"
                                        HorizontalAlignment="Stretch"
                                        ItemsSource="{x:Bind ViewModel.ResolutionChoices}"
                                        PlaceholderText="{x:Bind ViewModel.ResolutionPlaceholder, Mode=OneWay}"
                                        SelectedItem="{x:Bind ViewModel.SelectedResolution, Mode=TwoWay}"
                                        local:L.Header="Upscale.ResultResolution">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ResolutionChoice">
                                                <Grid ColumnSpacing="16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{x:Bind Name}" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Style="{StaticResource SecondaryCaptionTextStyle}"
                                                        Text="{x:Bind Caption}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <RadioButtons
                                        MaxColumns="2"
                                        SelectedIndex="{x:Bind ViewModel.FormatIndex, Mode=TwoWay}"
                                        local:L.Header="Upscale.Format">
                                        <x:String>PNG</x:String>
                                        <x:String>JPG</x:String>
                                    </RadioButtons>
                                </StackPanel>
                                </ContentControl>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!--  Estimate card  -->
                    <Border
                        Padding="24,16"
                        Style="{StaticResource CardBorderStyle}">
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" local:L.Text="Upscale.ResultResolution" />
                                <TextBlock Style="{StaticResource BodyLargeStrongTextBlockStyle}" Text="{x:Bind ViewModel.ResolutionValue, Mode=OneWay}" />
                                <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind ViewModel.ResolutionCaption, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" local:L.Text="Upscale.Estimate.Size" />
                                <TextBlock Style="{StaticResource BodyLargeStrongTextBlockStyle}" Text="{x:Bind ViewModel.FileSizeValue, Mode=OneWay}" />
                                <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind ViewModel.FileSizeCaption, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" local:L.Text="Upscale.Estimate.Time" />
                                <TextBlock Style="{StaticResource BodyLargeStrongTextBlockStyle}" Text="{x:Bind ViewModel.TimeValue, Mode=OneWay}" />
                                <TextBlock
                                    Style="{StaticResource SecondaryCaptionTextStyle}"
                                    Text="{x:Bind ViewModel.TimeCaption, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" local:L.Text="Upscale.Estimate.Ram" />
                                <TextBlock Style="{StaticResource BodyLargeStrongTextBlockStyle}" Text="{x:Bind ViewModel.RamValue, Mode=OneWay}" />
                                <TextBlock
                                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.RamCaption, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.RamEnoughVisible, Mode=OneWay}" />
                                <TextBlock
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.RamCaption, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.RamShortVisible, Mode=OneWay}" />
                            </StackPanel>
                            <Button
                                x:Name="StartButton"
                                Grid.Column="4"
                                VerticalAlignment="Center"
                                Command="{x:Bind ViewModel.StartCommand}"
                                Style="{StaticResource AccentButtonStyle}"
                                local:L.Content="Upscale.Start" />
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            AutomationProperties.AccessibilityView="Raw"
                            FontSize="16"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xEA18;" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryCaptionTextStyle}"
                            local:L.Text="Privacy.Note" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!--  Processing  -->
            <Border
                Margin="0,20,0,0"
                Padding="24"
                Style="{StaticResource CardBorderStyle}"
                Visibility="{x:Bind ViewModel.IsProcessing, Mode=OneWay}">
                <StackPanel Spacing="20">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock
                                AutomationProperties.HeadingLevel="Level2"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="{x:Bind ViewModel.ProcessingTitle, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                            <TextBlock
                                Style="{StaticResource SecondaryCaptionTextStyle}"
                                Text="{x:Bind ViewModel.ProcessingCaption, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                        </StackPanel>
                        <Button
                            x:Name="CancelButton"
                            Grid.Column="1"
                            VerticalAlignment="Top"
                            Command="{x:Bind ViewModel.CancelCommand}"
                            local:L.Content="Processing.Cancel">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Escape" />
                            </Button.KeyboardAccelerators>
                        </Button>
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar
                            VerticalAlignment="Center"
                            IsIndeterminate="{x:Bind ViewModel.IsIndeterminate, Mode=OneWay}"
                            Maximum="100"
                            Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}"
                            local:L.AutomationName="Upscale.ProgressSpoken" />
                        <TextBlock
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" />
                    </Grid>

                    <ItemsControl IsTabStop="False" ItemsSource="{x:Bind ViewModel.Steps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ConversionStepViewModel">
                                <Grid
                                    Height="40"
                                    AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}"
                                    ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Grid
                                        Width="20"
                                        Height="20"
                                        Visibility="{x:Bind IsDone, Mode=OneWay}">
                                        <Ellipse Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <FontIcon
                                            AutomationProperties.AccessibilityView="Raw"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                            Glyph="&#xE73E;" />
                                    </Grid>
                                    <ProgressRing
                                        Width="20"
                                        Height="20"
                                        IsActive="{x:Bind IsActive, Mode=OneWay}"
                                        Visibility="{x:Bind IsActive, Mode=OneWay}" />
                                    <Ellipse
                                        Width="18"
                                        Height="18"
                                        Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                                        StrokeThickness="1"
                                        Visibility="{x:Bind IsWaiting, Mode=OneWay}" />

                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Style="{x:Bind views:ConverterCard.StepLabelStyle(State), Mode=OneWay}"
                                        Text="{x:Bind Label}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SecondaryCaptionTextStyle}"
                                        Text="{x:Bind Detail, Mode=OneWay}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!--  Done  -->
            <Border
                Margin="0,20,0,0"
                Padding="24"
                Style="{StaticResource CardBorderStyle}"
                Visibility="{x:Bind ViewModel.IsDone, Mode=OneWay}">
                <StackPanel Spacing="20">
                    <InfoBar
                        IsClosable="False"
                        IsOpen="True"
                        Severity="Success"
                        local:L.Message="Upscale.Done.Message"
                        local:L.Title="Upscale.Done.Title" />
                    <Grid ColumnSpacing="16" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource SecondaryBodyTextStyle}" local:L.Text="Done.Location" />
                        <TextBlock
                            Grid.Column="1"
                            IsTextSelectionEnabled="True"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind ViewModel.Result.OutputPath, Mode=OneWay, FallbackValue=''}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap"
                            ToolTipService.ToolTip="{x:Bind ViewModel.Result.OutputPath, Mode=OneWay, FallbackValue=''}" />
                        <TextBlock
                            Grid.Row="1"
                            Style="{StaticResource SecondaryBodyTextStyle}"
                            local:L.Text="Upscale.Done.Resolution" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind ViewModel.ResultResolution, Mode=OneWay}" />
                        <TextBlock
                            Grid.Row="2"
                            Style="{StaticResource SecondaryBodyTextStyle}"
                            local:L.Text="Upscale.Done.Engine" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="1"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind ViewModel.ResultEngine, Mode=OneWay}" />
                        <TextBlock
                            Grid.Row="3"
                            Style="{StaticResource SecondaryBodyTextStyle}"
                            local:L.Text="Done.Integrity" />
                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="1"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind ViewModel.ResultIntegrity, Mode=OneWay}" />
                    </Grid>
                    <StackPanel>
                        <ItemsControl IsTabStop="False" ItemsSource="{x:Bind ViewModel.ResultNotes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ResultNoteItem">
                                    <InfoBar
                                        Margin="0,0,0,20"
                                        IsClosable="False"
                                        IsOpen="True"
                                        Message="{x:Bind Message}"
                                        Severity="{x:Bind Severity}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <InfoBar
                            Margin="0,0,0,20"
                            IsClosable="False"
                            IsOpen="{x:Bind ViewModel.HasResultMessage, Mode=OneWay}"
                            Message="{x:Bind ViewModel.ResultMessage, Mode=OneWay}"
                            Severity="Warning"
                            Visibility="{x:Bind ViewModel.HasResultMessage, Mode=OneWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="OpenResultButton"
                                Command="{x:Bind ViewModel.OpenResultCommand}"
                                Style="{StaticResource AccentButtonStyle}"
                                local:L.Content="Done.OpenFile" />
                            <Button Command="{x:Bind ViewModel.ShowResultInFolderCommand}" local:L.Content="Done.ShowInFolder" />
                            <HyperlinkButton Command="{x:Bind ViewModel.UpscaleAnotherCommand}" local:L.Content="Upscale.Done.Another" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  Failed  -->
            <Border
                Margin="0,20,0,0"
                Padding="24"
                Style="{StaticResource CardBorderStyle}"
                Visibility="{x:Bind ViewModel.IsFailed, Mode=OneWay}">
                <StackPanel Spacing="20">
                    <InfoBar
                        IsClosable="False"
                        IsOpen="True"
                        Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                        Severity="Error"
                        local:L.Title="Upscale.Failed.Title" />
                    <Grid ColumnSpacing="16" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource SecondaryBodyTextStyle}" local:L.Text="Failed.File" />
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind ViewModel.Source.Name, Mode=OneWay, FallbackValue=''}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="RetryButton"
                            Command="{x:Bind ViewModel.RetryCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            local:L.Content="Failed.TryAgain" />
                        <Button Command="{x:Bind ViewModel.BackToInputCommand}" local:L.Content="Failed.ChangeChoice" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
