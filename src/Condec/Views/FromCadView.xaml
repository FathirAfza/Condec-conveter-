<?xml version="1.0" encoding="utf-8"?>
<!--  Architecture, "DWG, DXF → Gambar, PDF" (DESIGN §6.3.2, §6.3.4): drop area, the queue, reading, review (preview, options, layers) and the conversion.  -->
<UserControl
    x:Class="Condec.Views.FromCadView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Condec"
    xmlns:views="using:Condec.Views"
    xmlns:vm="using:Condec.ViewModels">

    <UserControl.Resources>
        <Style
            x:Key="LayerItemStyle"
            BasedOn="{StaticResource DefaultListViewItemStyle}"
            TargetType="ListViewItem">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </UserControl.Resources>

    <StackPanel Spacing="16">

        <InfoBar
            CloseButtonCommand="{x:Bind ViewModel.DismissMessageCommand}"
            IsOpen="{x:Bind ViewModel.HasMessage, Mode=OneWay}"
            Message="{x:Bind ViewModel.Message, Mode=OneWay}"
            Severity="{x:Bind ViewModel.MessageSeverity, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.HasMessage, Mode=OneWay}" />

        <!--  The queue (DESIGN §6.3.4): which drawing is shown  -->
        <Border
            x:Name="QueueBar"
            Padding="16"
            Style="{StaticResource CardBorderStyle}"
            Visibility="{x:Bind ViewModel.ShowsQueue, Mode=OneWay}">
            <StackPanel Spacing="12">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox
                        HorizontalAlignment="Stretch"
                        local:L.Header="Queue.Header"
                        ItemsSource="{x:Bind ViewModel.Items}"
                        SelectedIndex="{x:Bind ViewModel.CurrentIndex, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:FromCadItem">
                                <TextBlock
                                    Text="{x:Bind Label, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button
                        Grid.Column="1"
                        VerticalAlignment="Bottom"
                        local:L.AutomationName="Queue.Previous"
                        Command="{x:Bind ViewModel.PreviousCommand}"
                        local:L.ToolTip="Queue.Previous">
                        <FontIcon FontSize="14" Glyph="&#xE76B;" />
                    </Button>
                    <Button
                        Grid.Column="2"
                        VerticalAlignment="Bottom"
                        local:L.AutomationName="Queue.Next"
                        Command="{x:Bind ViewModel.NextCommand}"
                        local:L.ToolTip="Queue.Next">
                        <FontIcon FontSize="14" Glyph="&#xE76C;" />
                    </Button>
                    <Button
                        Grid.Column="3"
                        VerticalAlignment="Bottom"
                        Command="{x:Bind ViewModel.RemoveCurrentCommand}"
                        local:L.Content="Queue.Remove" />
                </Grid>
                <TextBlock
                    Style="{StaticResource SecondaryCaptionTextStyle}"
                    Text="{x:Bind ViewModel.QueueStatusText, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!--  Empty: the drop area  -->
        <Grid
            AllowDrop="True"
            DragOver="OnDragOver"
            Drop="OnDrop"
            Visibility="{x:Bind ViewModel.ShowsEmpty, Mode=OneWay}">
            <Border
                Height="400"
                Padding="24"
                Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Rectangle
                        Fill="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        RadiusX="8"
                        RadiusY="8"
                        Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                        StrokeDashArray="4,3"
                        StrokeThickness="1" />
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">
                        <FontIcon
                            HorizontalAlignment="Center"
                            AutomationProperties.AccessibilityView="Raw"
                            FontSize="40"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Glyph="&#xE898;" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource BodyTextBlockStyle}"
                            local:L.Text="Architecture.FromCad.DropHere" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource SecondaryCaptionTextStyle}"
                            local:L.Text="Architecture.FromCad.DropFormats" />
                        <Button
                            x:Name="PickFileButton"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Center"
                            Command="{x:Bind ViewModel.PickSourceCommand}"
                            local:L.Content="Input.ChooseMany"
                            Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!--  Reading: the drawing is being opened  -->
        <Border
            Padding="24"
            Style="{StaticResource CardBorderStyle}"
            Visibility="{x:Bind ViewModel.ShowsReading, Mode=OneWay}">
            <StackPanel Spacing="20">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="{x:Bind ViewModel.ReadingTitle, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                        <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" local:L.Text="Architecture.FromCad.ReadingCaption" />
                    </StackPanel>
                    <Button
                        x:Name="CancelReadingButton"
                        Grid.Column="1"
                        VerticalAlignment="Top"
                        Command="{x:Bind ViewModel.CancelReadingCommand}"
                        local:L.Content="Architecture.Reading.Cancel">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Escape" />
                        </Button.KeyboardAccelerators>
                    </Button>
                </Grid>
                <ProgressBar IsIndeterminate="True" local:L.AutomationName="Processing.ProgressSpoken" />
            </StackPanel>
        </Border>

        <!--  The drawing shown could not be read: why, and the way on  -->
        <Border
            Padding="24"
            Style="{StaticResource CardBorderStyle}"
            Visibility="{x:Bind ViewModel.ShowsFailedItem, Mode=OneWay}">
            <StackPanel Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon
                        AutomationProperties.AccessibilityView="Raw"
                        FontSize="20"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Glyph="&#xEA39;" />
                    <TextBlock
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        local:L.Text="Queue.Failed.Title" />
                </StackPanel>
                <TextBlock
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind ViewModel.SourceName, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
                <TextBlock
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="{x:Bind ViewModel.FailedItemMessage, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <Button
                    x:Name="RemoveFailedButton"
                    Command="{x:Bind ViewModel.RemoveFailedCommand}"
                    local:L.Content="Queue.Remove"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Border>

        <!--  Review  -->
        <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.ShowsReview, Mode=OneWay}">

            <InfoBar
                IsClosable="False"
                IsOpen="True"
                Message="{x:Bind ViewModel.ReadyMessage, Mode=OneWay}"
                Severity="Informational"
                Title="{x:Bind ViewModel.ReadyTitle, Mode=OneWay}" />

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="380" />
                </Grid.ColumnDefinitions>

                <!--  The preview: the drawing as it will be, without the layers that are hidden  -->
                <Border Padding="16" Style="{StaticResource CardBorderStyle}">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind ViewModel.SourceName, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />

                        <Grid Grid.Row="1" MinHeight="240">
                            <Border
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                Visibility="{x:Bind ViewModel.HasPreview, Mode=OneWay}">
                                <Image
                                    x:Name="PreviewImage"
                                    MaxHeight="460"
                                    AutomationProperties.Name="{x:Bind ViewModel.PreviewAlt, Mode=OneWay}"
                                    Stretch="Uniform" />
                            </Border>
                            <FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                AutomationProperties.AccessibilityView="Raw"
                                FontSize="64"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE8A5;"
                                Visibility="{x:Bind ViewModel.HasNoPreview, Mode=OneWay}" />
                        </Grid>

                        <StackPanel Grid.Row="2" Spacing="8">
                            <ProgressBar
                                IsIndeterminate="True"
                                local:L.AutomationName="Architecture.FromCad.PreviewWorking"
                                Visibility="{x:Bind ViewModel.IsPreviewWorking, Mode=OneWay}" />
                            <TextBlock
                                Style="{StaticResource SecondaryCaptionTextStyle}"
                                Text="{x:Bind ViewModel.PreviewMessage, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind ViewModel.HasPreviewMessage, Mode=OneWay}" />
                            <TextBlock
                                Style="{StaticResource SecondaryCaptionTextStyle}"
                                TextWrapping="Wrap"
                                local:L.Text="Architecture.FromCad.NoLayerShown"
                                Visibility="{x:Bind ViewModel.ShowsNoLayerNote, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  Options of the result, and the layers  -->
                <Border
                    Grid.Column="1"
                    Padding="16"
                    VerticalAlignment="Top"
                    Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            local:L.Text="Architecture.Options.Title" />

                        <RadioButtons
                            MaxColumns="3"
                            local:L.Header="Architecture.Options.Format"
                            SelectedIndex="{x:Bind ViewModel.FormatIndex, Mode=TwoWay}">
                            <RadioButton Content="PDF" />
                            <RadioButton Content="PNG" />
                            <RadioButton Content="JPG" />
                        </RadioButtons>

                        <RadioButtons
                            MaxColumns="2"
                            local:L.Header="Architecture.Options.Paper"
                            SelectedIndex="{x:Bind ViewModel.PaperIndex, Mode=TwoWay}">
                            <RadioButton Content="A4" />
                            <RadioButton Content="A3" />
                        </RadioButtons>

                        <RadioButtons
                            MaxColumns="3"
                            local:L.Header="Architecture.Options.Dpi"
                            IsEnabled="{x:Bind ViewModel.DpiEnabled, Mode=OneWay}"
                            SelectedIndex="{x:Bind ViewModel.DpiIndex, Mode=TwoWay}">
                            <RadioButton Content="150" />
                            <RadioButton Content="300" />
                            <RadioButton Content="600" />
                        </RadioButtons>

                        <RadioButtons
                            MaxColumns="2"
                            local:L.Header="Architecture.Options.Background"
                            SelectedIndex="{x:Bind ViewModel.BackgroundIndex, Mode=TwoWay}">
                            <RadioButton local:L.Content="Architecture.Background.White" />
                            <RadioButton IsEnabled="{x:Bind ViewModel.TransparentEnabled, Mode=OneWay}" local:L.Content="Architecture.Background.Transparent" />
                        </RadioButtons>

                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <TextBlock
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            local:L.Text="Architecture.Layers.Title" />
                        <ListView
                            x:Name="LayerList"
                            MaxHeight="260"
                            local:L.AutomationName="Architecture.Layers.Title"
                            IsItemClickEnabled="False"
                            ItemContainerStyle="{StaticResource LayerItemStyle}"
                            ItemsSource="{x:Bind ViewModel.Layers}"
                            SelectionMode="Multiple">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:LayerRow">
                                    <Grid AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Style="{StaticResource BodyTextBlockStyle}"
                                            Text="{x:Bind DisplayName}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource SecondaryCaptionTextStyle}"
                                            Text="{x:Bind Status, Mode=OneWay}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock
                            Style="{StaticResource SecondaryCaptionTextStyle}"
                            Text="{x:Bind ViewModel.EstimateText, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <FontIcon
                        AutomationProperties.AccessibilityView="Raw"
                        FontSize="16"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xEA18;" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource SecondaryCaptionTextStyle}"
                        local:L.Text="Privacy.Note" />
                </StackPanel>
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="PickAnotherButton"
                        Command="{x:Bind ViewModel.PickSourceCommand}"
                        local:L.Content="Architecture.PickAnother" />
                    <Button Command="{x:Bind ViewModel.AddSourcesCommand}" local:L.Content="Queue.AddFiles" />
                    <Button
                        x:Name="ConvertButton"
                        Command="{x:Bind ViewModel.ConvertCommand}"
                        Content="{x:Bind ViewModel.ConvertLabel, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <!--  Converting, done, failed  -->
        <Border
            Padding="24"
            Style="{StaticResource CardBorderStyle}"
            Visibility="{x:Bind ViewModel.Run.IsActive, Mode=OneWay}">
            <views:RunStatusView x:Name="RunView" />
        </Border>
    </StackPanel>
</UserControl>
