<?xml version="1.0" encoding="utf-8"?>
<!--  "Kalibrasi…" (DESIGN §6.3.1): two points on the picture and the real distance between them.  -->
<ContentDialog
    x:Class="Condec.Views.CalibrationDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Condec"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="False">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">880</x:Double>
        <Style x:Key="MarkerStyle" TargetType="Ellipse">
            <Setter Property="Stroke" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            <Setter Property="Fill" Value="{ThemeResource AccentFillColorSelectedTextBackgroundBrush}" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style x:Key="CursorStyle" TargetType="Ellipse">
            <Setter Property="Stroke" Value="{ThemeResource SystemFillColorCautionBrush}" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
    </ContentDialog.Resources>

    <StackPanel MinWidth="560" Spacing="12">
        <TextBlock
            x:Name="Instruction"
            Style="{StaticResource BodyTextBlockStyle}"
            TextWrapping="Wrap" />
        <TextBlock
            x:Name="KeyboardHint"
            Style="{StaticResource SecondaryCaptionTextStyle}"
            TextWrapping="Wrap" />

        <ContentControl
            x:Name="Focuser"
            HorizontalAlignment="Center"
            HorizontalContentAlignment="Center"
            IsTabStop="True"
            KeyDown="OnSurfaceKeyDown"
            GotFocus="OnSurfaceFocusChanged"
            LostFocus="OnSurfaceFocusChanged"
            UseSystemFocusVisuals="True">
            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Viewbox MaxHeight="380" Stretch="Uniform">
                    <Canvas x:Name="Surface" Background="Transparent" PointerPressed="OnSurfacePressed">
                        <Image x:Name="Picture" Stretch="Fill" />
                        <Line
                            x:Name="Link"
                            IsHitTestVisible="False"
                            Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                            Visibility="Collapsed" />
                        <Ellipse x:Name="First" Style="{StaticResource MarkerStyle}" Visibility="Collapsed" />
                        <Ellipse x:Name="Second" Style="{StaticResource MarkerStyle}" Visibility="Collapsed" />
                        <Ellipse x:Name="Cursor" Style="{StaticResource CursorStyle}" Visibility="Collapsed" />
                    </Canvas>
                </Viewbox>
            </Border>
        </ContentControl>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="PointsText"
                VerticalAlignment="Center"
                Style="{StaticResource BodyTextBlockStyle}" />
            <Button x:Name="ResetButton" Grid.Column="1" Click="OnResetClick" />
        </Grid>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <NumberBox
                x:Name="Length"
                Minimum="0"
                PlaceholderText="0"
                SpinButtonPlacementMode="Hidden"
                ValueChanged="OnValueChanged" />
            <ComboBox
                x:Name="Unit"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                SelectionChanged="OnUnitChanged" />
        </Grid>
    </StackPanel>
</ContentDialog>
