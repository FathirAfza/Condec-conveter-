<?xml version="1.0" encoding="utf-8"?>
<!--  The results of a batch, one row per file (DESIGN §6.1.3): Convert File and the Architecture page.  -->
<UserControl
    x:Class="Condec.Views.BatchResultList"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Condec"
    xmlns:vm="using:Condec.ViewModels">

    <ListView
        MaxHeight="360"
        local:L.AutomationName="Batch.ListSpoken"
        ItemsSource="{x:Bind Items, Mode=OneWay}"
        SelectionMode="None">
        <ListView.ItemTemplate>
            <DataTemplate x:DataType="vm:BatchResultItem">
                <Grid
                    MinHeight="44"
                    Padding="0,4"
                    AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}"
                    ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource SecondaryBodyTextStyle}"
                        Text="{x:Bind NumberText}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock
                            Text="{x:Bind OutputName, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                        <TextBlock
                            Style="{StaticResource SecondaryCaptionTextStyle}"
                            Text="{x:Bind Caption}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                        <TextBlock
                            Style="{StaticResource SecondaryCaptionTextStyle}"
                            Text="{x:Bind Detail, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind HasDetail, Mode=OneWay}" />
                    </StackPanel>
                    <!--  The state in words and an icon; color only repeats it (DESIGN §10).  -->
                    <StackPanel
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="4"
                        Visibility="{x:Bind IsDone, Mode=OneWay}">
                        <FontIcon
                            AutomationProperties.AccessibilityView="Raw"
                            FontSize="12"
                            Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                            Glyph="{x:Bind StatusGlyph, Mode=OneWay}" />
                        <TextBlock
                            Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind StatusText, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="4"
                        Visibility="{x:Bind IsFailed, Mode=OneWay}">
                        <FontIcon
                            AutomationProperties.AccessibilityView="Raw"
                            FontSize="12"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Glyph="{x:Bind StatusGlyph, Mode=OneWay}" />
                        <TextBlock
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind StatusText, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="4"
                        Visibility="{x:Bind IsWaitingOrCancelled, Mode=OneWay}">
                        <FontIcon
                            AutomationProperties.AccessibilityView="Raw"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="{x:Bind StatusGlyph, Mode=OneWay}" />
                        <TextBlock
                            Style="{StaticResource SecondaryCaptionTextStyle}"
                            Text="{x:Bind StatusText, Mode=OneWay}" />
                    </StackPanel>
                    <Button
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{x:Bind ShowInFolderName, Mode=OneWay}"
                        Command="{x:Bind ShowInFolderCommand}"
                        Style="{StaticResource SubtleButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind ShowInFolderName, Mode=OneWay}"
                        Visibility="{x:Bind IsDone, Mode=OneWay}">
                        <FontIcon FontSize="16" Glyph="&#xE838;" />
                    </Button>
                </Grid>
            </DataTemplate>
        </ListView.ItemTemplate>
    </ListView>
</UserControl>
