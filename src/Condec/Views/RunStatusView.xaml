<?xml version="1.0" encoding="utf-8"?>
<!--  The processing, done and failed views of DESIGN §6.1, for a page that has its own input (Architecture).  -->
<UserControl
    x:Class="Condec.Views.RunStatusView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Condec"
    xmlns:views="using:Condec.Views"
    xmlns:vm="using:Condec.ViewModels">

    <Grid>

        <!--  Processing  -->
        <StackPanel Spacing="20" Visibility="{x:Bind Run.IsProcessing, Mode=OneWay}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="{x:Bind Run.ProcessingTitle, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                    <TextBlock
                        Style="{StaticResource SecondaryCaptionTextStyle}"
                        Text="{x:Bind Run.ProcessingCaption, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                </StackPanel>
                <Button
                    x:Name="CancelButton"
                    Grid.Column="1"
                    VerticalAlignment="Top"
                    Command="{x:Bind Run.CancelCommand}"
                    local:L.Content="Processing.Cancel">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Escape" />
                    </Button.KeyboardAccelerators>
                </Button>
            </Grid>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <ProgressBar
                    VerticalAlignment="Center"
                    local:L.AutomationName="Processing.ProgressSpoken"
                    Maximum="100"
                    Value="{x:Bind Run.ProgressPercent, Mode=OneWay}" />
                <TextBlock
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="{x:Bind Run.ProgressText, Mode=OneWay}" />
            </Grid>

            <!--  A batch: which file the four stages below belong to.  -->
            <TextBlock
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind Run.BatchCurrentText, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap"
                Visibility="{x:Bind Run.IsBatch, Mode=OneWay}" />

            <ItemsControl IsTabStop="False" ItemsSource="{x:Bind Run.Steps}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ConversionStepViewModel">
                        <Grid
                            Height="40"
                            AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}"
                            ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid
                                Width="20"
                                Height="20"
                                Visibility="{x:Bind IsDone, Mode=OneWay}">
                                <Ellipse Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                                <FontIcon
                                    AutomationProperties.AccessibilityView="Raw"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    Glyph="&#xE73E;" />
                            </Grid>
                            <ProgressRing
                                Width="20"
                                Height="20"
                                IsActive="{x:Bind IsActive, Mode=OneWay}"
                                Visibility="{x:Bind IsActive, Mode=OneWay}" />
                            <Ellipse
                                Width="18"
                                Height="18"
                                Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                                StrokeThickness="1"
                                Visibility="{x:Bind IsWaiting, Mode=OneWay}" />

                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Style="{x:Bind views:RunStatusView.StepLabelStyle(State), Mode=OneWay}"
                                Text="{x:Bind Label}" />
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Style="{StaticResource SecondaryCaptionTextStyle}"
                                Text="{x:Bind Detail, Mode=OneWay}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!--  Done: one file  -->
        <StackPanel Spacing="20" Visibility="{x:Bind Run.IsSingleDone, Mode=OneWay}">
            <InfoBar
                IsClosable="False"
                IsOpen="True"
                local:L.Message="Done.Message"
                Severity="Success"
                local:L.Title="Done.Title" />
            <Grid ColumnSpacing="16" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource SecondaryBodyTextStyle}" local:L.Text="Done.Location" />
                <TextBlock
                    Grid.Column="1"
                    IsTextSelectionEnabled="True"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="{x:Bind Run.Result.OutputPath, Mode=OneWay, FallbackValue=''}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap"
                    ToolTipService.ToolTip="{x:Bind Run.Result.OutputPath, Mode=OneWay, FallbackValue=''}" />
                <TextBlock
                    Grid.Row="1"
                    Style="{StaticResource SecondaryBodyTextStyle}"
                    local:L.Text="Done.Format" />
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="1"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="{x:Bind Run.ConversionFormat, Mode=OneWay}" />
                <TextBlock
                    Grid.Row="2"
                    Style="{StaticResource SecondaryBodyTextStyle}"
                    local:L.Text="Done.Integrity" />
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="1"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="{x:Bind Run.ResultIntegrity, Mode=OneWay}" />
            </Grid>
            <StackPanel>
                <ItemsControl IsTabStop="False" ItemsSource="{x:Bind Run.ResultNotes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ResultNoteItem">
                            <InfoBar
                                Margin="0,0,0,20"
                                IsClosable="False"
                                IsOpen="True"
                                Message="{x:Bind Message}"
                                Severity="{x:Bind Severity}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <InfoBar
                    Margin="0,0,0,20"
                    IsClosable="False"
                    IsOpen="{x:Bind Run.HasResultMessage, Mode=OneWay}"
                    Message="{x:Bind Run.ResultMessage, Mode=OneWay}"
                    Severity="Warning"
                    Visibility="{x:Bind Run.HasResultMessage, Mode=OneWay}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        x:Name="OpenResultButton"
                        Command="{x:Bind Run.OpenResultCommand}"
                        local:L.Content="Done.OpenFile"
                        Style="{StaticResource AccentButtonStyle}" />
                    <Button Command="{x:Bind Run.ShowResultInFolderCommand}" local:L.Content="Done.ShowInFolder" />
                    <HyperlinkButton Command="{x:Bind Run.AnotherCommand}" local:L.Content="Done.ConvertAnother" />
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!--  Done: a batch (DESIGN §6.1.3), whether all, some or none of its results were saved  -->
        <StackPanel Spacing="20" Visibility="{x:Bind Run.IsBatchDone, Mode=OneWay}">
            <InfoBar
                IsClosable="False"
                IsOpen="True"
                Message="{x:Bind Run.BatchMessage, Mode=OneWay}"
                Severity="{x:Bind Run.BatchSeverity, Mode=OneWay}"
                Title="{x:Bind Run.BatchTitle, Mode=OneWay}" />
            <Grid ColumnSpacing="16" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource SecondaryBodyTextStyle}" local:L.Text="Done.Location" />
                <TextBlock
                    Grid.Column="1"
                    IsTextSelectionEnabled="True"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="{x:Bind Run.BatchFolder, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap"
                    ToolTipService.ToolTip="{x:Bind Run.BatchFolder, Mode=OneWay}" />
                <TextBlock
                    Grid.Row="1"
                    Style="{StaticResource SecondaryBodyTextStyle}"
                    local:L.Text="Done.Format" />
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="1"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="{x:Bind Run.ConversionFormat, Mode=OneWay}" />
                <TextBlock
                    Grid.Row="2"
                    Style="{StaticResource SecondaryBodyTextStyle}"
                    local:L.Text="Batch.ResultLabel" />
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="1"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="{x:Bind Run.BatchSavedText, Mode=OneWay}" />
            </Grid>
            <views:BatchResultList x:Name="BatchList" />
            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind Run.HasResultMessage, Mode=OneWay}"
                Message="{x:Bind Run.ResultMessage, Mode=OneWay}"
                Severity="Warning"
                Visibility="{x:Bind Run.HasResultMessage, Mode=OneWay}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    x:Name="OpenFolderButton"
                    Command="{x:Bind Run.OpenBatchFolderCommand}"
                    local:L.Content="Batch.OpenFolder"
                    Style="{StaticResource AccentButtonStyle}"
                    Visibility="{x:Bind Run.BatchHasSaved, Mode=OneWay}" />
                <Button
                    x:Name="RetryBatchButton"
                    Command="{x:Bind Run.RetryBatchCommand}"
                    Content="{x:Bind Run.BatchRetryLabel, Mode=OneWay}"
                    Visibility="{x:Bind Run.BatchHasUnsaved, Mode=OneWay}" />
                <Button
                    Command="{x:Bind Run.BackCommand}"
                    local:L.Content="Failed.ChangeChoice"
                    Visibility="{x:Bind Run.BatchSavedNothing, Mode=OneWay}" />
                <HyperlinkButton Command="{x:Bind Run.AnotherCommand}" local:L.Content="Done.ConvertAnother" />
            </StackPanel>
        </StackPanel>

        <!--  Failed  -->
        <StackPanel Spacing="20" Visibility="{x:Bind Run.IsFailed, Mode=OneWay}">
            <InfoBar
                IsClosable="False"
                IsOpen="True"
                Message="{x:Bind Run.ErrorMessage, Mode=OneWay}"
                Severity="Error"
                local:L.Title="Failed.Title" />
            <Grid ColumnSpacing="16" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource SecondaryBodyTextStyle}" local:L.Text="Failed.File" />
                <TextBlock
                    Grid.Column="1"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="{x:Bind Run.SourceName, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
                <TextBlock
                    Grid.Row="1"
                    Style="{StaticResource SecondaryBodyTextStyle}"
                    local:L.Text="Done.Format" />
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="1"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="{x:Bind Run.ConversionFormat, Mode=OneWay}" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    x:Name="RetryButton"
                    Command="{x:Bind Run.RetryCommand}"
                    local:L.Content="Failed.TryAgain"
                    Style="{StaticResource AccentButtonStyle}" />
                <Button Command="{x:Bind Run.BackCommand}" local:L.Content="Failed.ChangeChoice" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
