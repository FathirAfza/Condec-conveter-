<?xml version="1.0" encoding="utf-8"?>
<!--  Compress (DESIGN §6.5): the pictures and PDFs, how to make them smaller, the measured result of the one shown, then the progress and the results.  -->
<Page
    x:Class="Condec.Views.CompressPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Condec"
    xmlns:views="using:Condec.Views"
    xmlns:vm="using:Condec.ViewModels"
    NavigationCacheMode="Required">

    <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Disabled">
        <StackPanel
            x:Name="Column"
            Margin="40,28,40,32"
            HorizontalAlignment="Left">
            <TextBlock
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource TitleTextBlockStyle}"
                local:L.Text="Page.Compress.Title" />
            <TextBlock
                Margin="0,4,0,0"
                Style="{StaticResource SecondaryBodyTextStyle}"
                local:L.Text="Page.Compress.Subtitle"
                TextWrapping="WrapWholeWords" />

            <!--  Input  -->
            <StackPanel Margin="0,20,0,0" Visibility="{x:Bind ViewModel.IsInput, Mode=OneWay}">
                <InfoBar
                    Margin="0,0,0,16"
                    CloseButtonCommand="{x:Bind ViewModel.DismissInputMessageCommand}"
                    IsOpen="{x:Bind ViewModel.HasInputMessage, Mode=OneWay}"
                    Message="{x:Bind ViewModel.InputMessage, Mode=OneWay}"
                    Severity="{x:Bind ViewModel.InputMessageSeverity, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.HasInputMessage, Mode=OneWay}" />

                <!--  No file yet: the drop target.  -->
                <Border
                    Padding="24"
                    Style="{StaticResource CardBorderStyle}"
                    Visibility="{x:Bind ViewModel.HasNoSource, Mode=OneWay}">
                    <Grid
                        Height="168"
                        AllowDrop="True"
                        DragOver="OnSourceDragOver"
                        Drop="OnSourceDrop">
                        <Rectangle
                            Fill="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            RadiusX="8"
                            RadiusY="8"
                            Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                            StrokeDashArray="4,3"
                            StrokeThickness="1" />
                        <StackPanel
                            Padding="16,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8">
                            <FontIcon
                                HorizontalAlignment="Center"
                                AutomationProperties.AccessibilityView="Raw"
                                FontSize="32"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE898;" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Style="{StaticResource BodyTextBlockStyle}"
                                local:L.Text="Compress.DropHere" />
                            <Button
                                x:Name="PickFileButton"
                                HorizontalAlignment="Center"
                                Command="{x:Bind ViewModel.PickSourceCommand}"
                                local:L.Content="Compress.Choose" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Style="{StaticResource SecondaryCaptionTextStyle}"
                                local:L.Text="Compress.Formats"
                                TextAlignment="Center"
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  Files are chosen: the file and its result next to the choices, then the result's numbers.  -->
                <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.HasSource, Mode=OneWay}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="380" />
                        </Grid.ColumnDefinitions>

                        <!--  Left card: the file shown, the list, and the preview of its result  -->
                        <Border Padding="24" Style="{StaticResource CardBorderStyle}">
                            <Grid
                                AllowDrop="True"
                                DragOver="OnSourceDragOver"
                                Drop="OnSourceDrop"
                                RowSpacing="16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        VerticalAlignment="Center"
                                        AutomationProperties.AccessibilityView="Raw"
                                        FontSize="32"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="{x:Bind ViewModel.SourceGlyph, Mode=OneWay}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="{x:Bind ViewModel.SourceName, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap"
                                            ToolTipService.ToolTip="{x:Bind ViewModel.SourcePath, Mode=OneWay}" />
                                        <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind ViewModel.SourceCaption, Mode=OneWay}" />
                                    </StackPanel>
                                    <StackPanel
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <HyperlinkButton Command="{x:Bind ViewModel.AddSourcesCommand}" local:L.Content="Compress.AddFiles" />
                                        <HyperlinkButton
                                            x:Name="ChangeFileButton"
                                            local:L.AutomationName="Source.ChangeSpoken"
                                            Command="{x:Bind ViewModel.PickSourceCommand}"
                                            local:L.Content="Source.Change" />
                                    </StackPanel>
                                </Grid>

                                <!--  Two files or more: the one selected is the one whose result is shown.  -->
                                <StackPanel
                                    Grid.Row="1"
                                    Spacing="8"
                                    Visibility="{x:Bind ViewModel.HasSeveral, Mode=OneWay}">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.ListTitle, Mode=OneWay}" />
                                    <ListView
                                        x:Name="PictureList"
                                        MaxHeight="220"
                                        local:L.AutomationName="Compress.ListSpoken"
                                        ItemsSource="{x:Bind ViewModel.Items}"
                                        SelectedIndex="{x:Bind ViewModel.CurrentIndex, Mode=TwoWay}"
                                        SelectionMode="Single">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="vm:CompressItem">
                                                <Grid
                                                    MinHeight="40"
                                                    AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}"
                                                    ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource SecondaryBodyTextStyle}"
                                                        Text="{x:Bind NumberText, Mode=OneWay}" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock
                                                            Text="{x:Bind Name}"
                                                            TextTrimming="CharacterEllipsis"
                                                            TextWrapping="NoWrap" />
                                                        <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind Caption}" />
                                                    </StackPanel>
                                                    <Button
                                                        Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        AutomationProperties.Name="{x:Bind RemoveName}"
                                                        Command="{x:Bind RemoveCommand}"
                                                        Style="{StaticResource SubtleButtonStyle}"
                                                        ToolTipService.ToolTip="{x:Bind RemoveName}">
                                                        <FontIcon FontSize="12" Glyph="&#xE711;" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>

                                <!--  The result itself, decoded from the bytes that were measured: the picture, or the largest picture of the PDF.  -->
                                <StackPanel Grid.Row="2" Spacing="8">
                                    <Grid
                                        MinHeight="220"
                                        CornerRadius="4"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                        <Image
                                            x:Name="PreviewImage"
                                            MaxHeight="340"
                                            AutomationProperties.Name="{x:Bind ViewModel.PreviewSpoken, Mode=OneWay}"
                                            Stretch="Uniform" />
                                        <ProgressRing
                                            Width="32"
                                            Height="32"
                                            IsActive="{x:Bind ViewModel.IsMeasuring, Mode=OneWay}"
                                            Visibility="{x:Bind ViewModel.IsMeasuring, Mode=OneWay}" />
                                    </Grid>
                                    <TextBlock
                                        Style="{StaticResource SecondaryCaptionTextStyle}"
                                        Text="{x:Bind ViewModel.PreviewCaption, Mode=OneWay}"
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!--  Right card: format, how to compress, and its settings  -->
                        <Border
                            Grid.Column="1"
                            Padding="24"
                            Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="16">
                                <StackPanel Spacing="4">
                                    <RadioButtons
                                        x:Name="FormatButtons"
                                        IsEnabled="{x:Bind ViewModel.HasPictures, Mode=OneWay}"
                                        ItemsSource="{x:Bind ViewModel.FormatChoices}"
                                        MaxColumns="3"
                                        SelectedIndex="{x:Bind ViewModel.FormatIndex, Mode=TwoWay}"
                                        local:L.Header="Compress.Format">
                                        <!--  A radio button is at least 120 wide by default; three of those don't fit in one row of this card.  -->
                                        <RadioButtons.Resources>
                                            <Style BasedOn="{StaticResource DefaultRadioButtonStyle}" TargetType="RadioButton">
                                                <Setter Property="MinWidth" Value="96" />
                                            </Style>
                                        </RadioButtons.Resources>
                                    </RadioButtons>
                                    <TextBlock
                                        Style="{StaticResource SecondaryCaptionTextStyle}"
                                        Text="{x:Bind ViewModel.FormatCaption, Mode=OneWay}"
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>

                                <RadioButtons SelectedIndex="{x:Bind ViewModel.ModeIndex, Mode=TwoWay}" local:L.Header="Compress.Mode">
                                    <RadioButton local:L.Content="Compress.Mode.Manual" />
                                    <RadioButton local:L.Content="Compress.Mode.Target" />
                                </RadioButtons>

                                <!--  By hand: quality and resolution  -->
                                <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.IsManual, Mode=OneWay}">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Style="{StaticResource BodyTextBlockStyle}" local:L.Text="Compress.Quality" />
                                            <TextBlock
                                                HorizontalAlignment="Right"
                                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                                Text="{x:Bind ViewModel.QualityText, Mode=OneWay}"
                                                Visibility="{x:Bind ViewModel.HasQuality, Mode=OneWay}" />
                                        </Grid>
                                        <Slider
                                            IsEnabled="{x:Bind ViewModel.HasQuality, Mode=OneWay}"
                                            Maximum="100"
                                            Minimum="10"
                                            StepFrequency="5"
                                            TickFrequency="10"
                                            TickPlacement="BottomRight"
                                            Value="{x:Bind ViewModel.Quality, Mode=TwoWay}"
                                            local:L.AutomationName="Compress.Quality" />
                                        <TextBlock
                                            Style="{StaticResource SecondaryCaptionTextStyle}"
                                            Text="{x:Bind ViewModel.QualityNote, Mode=OneWay}"
                                            TextWrapping="WrapWholeWords"
                                            Visibility="{x:Bind ViewModel.HasNoQuality, Mode=OneWay}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Style="{StaticResource BodyTextBlockStyle}" local:L.Text="Compress.Resolution" />
                                            <TextBlock
                                                HorizontalAlignment="Right"
                                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                                Text="{x:Bind ViewModel.ResolutionText, Mode=OneWay}" />
                                        </Grid>
                                        <Slider
                                            Maximum="100"
                                            Minimum="10"
                                            StepFrequency="5"
                                            TickFrequency="10"
                                            TickPlacement="BottomRight"
                                            Value="{x:Bind ViewModel.ResolutionPercent, Mode=TwoWay}"
                                            local:L.AutomationName="Compress.Resolution" />
                                        <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind ViewModel.ResolutionSizeText, Mode=OneWay}" />
                                    </StackPanel>
                                </StackPanel>

                                <!--  A size limit: the quality and resolution are found for each file  -->
                                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.IsTargetMode, Mode=OneWay}">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <NumberBox
                                            x:Name="TargetBox"
                                            LargeChange="1"
                                            Maximum="1000000"
                                            Minimum="0"
                                            SmallChange="1"
                                            SpinButtonPlacementMode="Compact"
                                            Value="{x:Bind ViewModel.TargetValue, Mode=TwoWay}"
                                            local:L.Header="Compress.Limit" />
                                        <ComboBox
                                            Grid.Column="1"
                                            MinWidth="88"
                                            VerticalAlignment="Bottom"
                                            SelectedIndex="{x:Bind ViewModel.TargetUnitIndex, Mode=TwoWay}"
                                            local:L.AutomationName="Compress.LimitUnit">
                                            <x:String>KB</x:String>
                                            <x:String>MB</x:String>
                                        </ComboBox>
                                    </Grid>
                                    <TextBlock
                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        local:L.Text="Compress.LimitInvalid"
                                        TextWrapping="WrapWholeWords"
                                        Visibility="{x:Bind ViewModel.IsTargetInvalid, Mode=OneWay}" />
                                    <TextBlock
                                        Style="{StaticResource SecondaryCaptionTextStyle}"
                                        Text="{x:Bind ViewModel.LimitHelp, Mode=OneWay}"
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>

                                <TextBlock
                                    Style="{StaticResource SecondaryCaptionTextStyle}"
                                    Text="{x:Bind ViewModel.KeepsNote, Mode=OneWay}"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!--  The result of the file shown: measured, not estimated  -->
                    <Border Padding="24,16" Style="{StaticResource CardBorderStyle}">
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" local:L.Text="Compress.Original" />
                                <TextBlock Style="{StaticResource BodyLargeStrongTextBlockStyle}" Text="{x:Bind ViewModel.OriginalSizeValue, Mode=OneWay}" />
                                <TextBlock
                                    Style="{StaticResource SecondaryCaptionTextStyle}"
                                    Text="{x:Bind ViewModel.OriginalSizeCaption, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" local:L.Text="Compress.ResultSize" />
                                <TextBlock Style="{StaticResource BodyLargeStrongTextBlockStyle}" Text="{x:Bind ViewModel.ResultSizeValue, Mode=OneWay}" />
                                <TextBlock
                                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.ResultSizeCaption, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.IsSmaller, Mode=OneWay}" />
                                <TextBlock
                                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.ResultSizeCaption, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.IsLarger, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind ViewModel.ResultResolutionLabel, Mode=OneWay}" />
                                <TextBlock Style="{StaticResource BodyLargeStrongTextBlockStyle}" Text="{x:Bind ViewModel.ResultResolutionValue, Mode=OneWay}" />
                                <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind ViewModel.ResultResolutionCaption, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" local:L.Text="Compress.Quality" />
                                <TextBlock Style="{StaticResource BodyLargeStrongTextBlockStyle}" Text="{x:Bind ViewModel.ResultQualityValue, Mode=OneWay}" />
                                <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind ViewModel.ResultQualityCaption, Mode=OneWay}" />
                            </StackPanel>
                            <Button
                                x:Name="StartButton"
                                Grid.Column="4"
                                VerticalAlignment="Center"
                                Command="{x:Bind ViewModel.StartCommand}"
                                Content="{x:Bind ViewModel.StartLabel, Mode=OneWay}"
                                Style="{StaticResource AccentButtonStyle}" />
                        </Grid>
                    </Border>

                    <!--  The file shown can't be made that small, has nothing to make smaller, or can't be read.  -->
                    <InfoBar
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.HasPreviewProblem, Mode=OneWay}"
                        Message="{x:Bind ViewModel.PreviewProblem, Mode=OneWay}"
                        Severity="Warning"
                        Visibility="{x:Bind ViewModel.HasPreviewProblem, Mode=OneWay}" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            AutomationProperties.AccessibilityView="Raw"
                            FontSize="16"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xEA18;" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryCaptionTextStyle}"
                            local:L.Text="Privacy.Note" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!--  Processing, done and failed, for one file or several  -->
            <Border
                Margin="0,20,0,0"
                Padding="24"
                Style="{StaticResource CardBorderStyle}"
                Visibility="{x:Bind ViewModel.Run.IsActive, Mode=OneWay}">
                <views:RunStatusView x:Name="RunView" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
