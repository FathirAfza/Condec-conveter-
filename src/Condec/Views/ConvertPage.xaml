<?xml version="1.0" encoding="utf-8"?>
<!--  Convert File (DESIGN §6.1): the converter card, then the history.  -->
<Page
    x:Class="Condec.Views.ConvertPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Condec"
    xmlns:views="using:Condec.Views"
    xmlns:vm="using:Condec.ViewModels"
    NavigationCacheMode="Required">

    <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Disabled">
        <StackPanel
            x:Name="Column"
            Margin="40,28,40,32"
            HorizontalAlignment="Left">
            <TextBlock
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource TitleTextBlockStyle}"
                local:L.Text="Page.Convert.Title" />
            <TextBlock
                Margin="0,4,0,0"
                Style="{StaticResource SecondaryBodyTextStyle}"
                local:L.Text="Page.Convert.Subtitle" />

            <views:ConverterCard x:Name="Card" Margin="0,20,0,0" />

            <!--  History  -->
            <Border Margin="0,16,0,0" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Padding="24,12,16,8" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            local:L.Text="History.Title" />
                        <CheckBox
                            Grid.Column="1"
                            MinWidth="0"
                            local:L.Content="History.Record"
                            IsChecked="{x:Bind ViewModel.IsHistoryEnabled, Mode=TwoWay}" />
                        <HyperlinkButton
                            Grid.Column="2"
                            Click="OnClearHistoryClicked"
                            local:L.Content="History.Clear"
                            IsEnabled="{x:Bind ViewModel.HasHistory, Mode=OneWay}">
                            <FlyoutBase.AttachedFlyout>
                                <Flyout x:Name="ClearHistoryFlyout">
                                    <StackPanel MaxWidth="280" Spacing="12">
                                        <TextBlock Style="{StaticResource BodyTextBlockStyle}" local:L.Text="History.ClearConfirm" />
                                        <Button
                                            Click="OnClearHistoryConfirmed"
                                            Command="{x:Bind ViewModel.ClearHistoryCommand}"
                                            local:L.Content="History.ClearConfirmButton" />
                                    </StackPanel>
                                </Flyout>
                            </FlyoutBase.AttachedFlyout>
                        </HyperlinkButton>
                    </Grid>

                    <InfoBar
                        Grid.Row="1"
                        Margin="24,0,24,8"
                        CloseButtonCommand="{x:Bind ViewModel.DismissHistoryMessageCommand}"
                        IsOpen="{x:Bind ViewModel.HasHistoryMessage, Mode=OneWay}"
                        Message="{x:Bind ViewModel.HistoryMessage, Mode=OneWay}"
                        Severity="Warning"
                        Visibility="{x:Bind ViewModel.HasHistoryMessage, Mode=OneWay}" />

                    <ItemsRepeater
                        Grid.Row="2"
                        Margin="8,0,8,8"
                        ItemsSource="{x:Bind ViewModel.HistoryItems}"
                        Visibility="{x:Bind ViewModel.HasHistory, Mode=OneWay}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:HistoryItemViewModel">
                                <Grid
                                    Padding="16,8,8,8"
                                    AutomationProperties.Name="{x:Bind AutomationName}"
                                    ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="32" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Width="32"
                                        Height="32"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="{StaticResource ControlCornerRadius}">
                                        <FontIcon
                                            AutomationProperties.AccessibilityView="Raw"
                                            FontSize="16"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Glyph="{x:Bind Glyph}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock
                                            Style="{StaticResource BodyTextBlockStyle}"
                                            Text="{x:Bind Name}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />
                                        <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind Summary}" />
                                    </StackPanel>
                                    <StackPanel
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="4"
                                        Visibility="{x:Bind IsVerified}">
                                        <FontIcon
                                            AutomationProperties.AccessibilityView="Raw"
                                            FontSize="12"
                                            Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                            Glyph="&#xE73E;" />
                                        <TextBlock
                                            Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            local:L.Text="History.Verified" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="3"
                                        Width="32"
                                        Height="32"
                                        Padding="0"
                                        AutomationProperties.Name="{x:Bind ShowInFolderName}"
                                        Command="{x:Bind ShowInFolderCommand}"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        local:L.ToolTip="Done.ShowInFolder">
                                        <FontIcon FontSize="16" Glyph="&#xE838;" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <TextBlock
                        Grid.Row="2"
                        Margin="24,8,24,24"
                        Style="{StaticResource SecondaryBodyTextStyle}"
                        Text="{x:Bind ViewModel.HistoryEmptyText, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasNoHistory, Mode=OneWay}" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
