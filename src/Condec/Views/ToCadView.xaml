<?xml version="1.0" encoding="utf-8"?>
<!--  Architecture, "Gambar, PDF, DXF → DWG" (DESIGN §6.3.1): drop area, reading, review (banner, preview, objects) and the conversion.  -->
<UserControl
    x:Class="Condec.Views.ToCadView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Condec"
    xmlns:views="using:Condec.Views"
    xmlns:vm="using:Condec.ViewModels">

    <UserControl.Resources>
        <!--  Boxes on the preview: what becomes CAD, what doesn't, and where the picture is unclear.  -->
        <Style x:Key="OverlayIncludedStyle" TargetType="Rectangle">
            <Setter Property="Stroke" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="OverlayExcludedStyle" TargetType="Rectangle">
            <Setter Property="Stroke" Value="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="OverlayUnclearStyle" TargetType="Rectangle">
            <Setter Property="Stroke" Value="{ThemeResource SystemFillColorCautionBrush}" />
        </Style>
        <Style x:Key="OverlayMarkStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>

        <Style
            x:Key="ObjectItemStyle"
            BasedOn="{StaticResource DefaultListViewItemStyle}"
            TargetType="ListViewItem">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </UserControl.Resources>

    <StackPanel Spacing="16">

        <InfoBar
            CloseButtonCommand="{x:Bind ViewModel.DismissMessageCommand}"
            IsOpen="{x:Bind ViewModel.HasMessage, Mode=OneWay}"
            Message="{x:Bind ViewModel.Message, Mode=OneWay}"
            Severity="{x:Bind ViewModel.MessageSeverity, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.HasMessage, Mode=OneWay}" />

        <!--  The queue (DESIGN §6.3.4): which item is shown, the pages of the PDFs, and how their results are saved  -->
        <Border
            x:Name="QueueBar"
            Padding="16"
            Style="{StaticResource CardBorderStyle}"
            Visibility="{x:Bind ViewModel.ShowsQueue, Mode=OneWay}">
            <StackPanel Spacing="12">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox
                        x:Name="QueueList"
                        HorizontalAlignment="Stretch"
                        local:L.Header="Queue.Header"
                        IsEnabled="{x:Bind ViewModel.CanNavigate, Mode=OneWay}"
                        ItemsSource="{x:Bind ViewModel.Items}"
                        SelectedIndex="{x:Bind ViewModel.CurrentIndex, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ToCadItem">
                                <TextBlock
                                    Text="{x:Bind Label, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button
                        Grid.Column="1"
                        VerticalAlignment="Bottom"
                        local:L.AutomationName="Queue.Previous"
                        Command="{x:Bind ViewModel.PreviousCommand}"
                        local:L.ToolTip="Queue.Previous">
                        <FontIcon FontSize="14" Glyph="&#xE76B;" />
                    </Button>
                    <Button
                        Grid.Column="2"
                        VerticalAlignment="Bottom"
                        local:L.AutomationName="Queue.Next"
                        Command="{x:Bind ViewModel.NextCommand}"
                        local:L.ToolTip="Queue.Next">
                        <FontIcon FontSize="14" Glyph="&#xE76C;" />
                    </Button>
                    <Button
                        Grid.Column="3"
                        VerticalAlignment="Bottom"
                        Command="{x:Bind ViewModel.RemoveCurrentCommand}"
                        local:L.Content="Queue.Remove" />
                </Grid>

                <!--  Pages of the PDFs: each chosen page is one item of the queue  -->
                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.ShowsPageChoice, Mode=OneWay}">
                    <RadioButtons
                        local:L.Header="Pages.Header"
                        IsEnabled="{x:Bind ViewModel.CanNavigate, Mode=OneWay}"
                        MaxColumns="3"
                        SelectedIndex="{x:Bind ViewModel.Pages.ModeIndex, Mode=TwoWay}">
                        <RadioButton local:L.Content="Pages.All" />
                        <RadioButton local:L.Content="Pages.First" />
                        <RadioButton local:L.Content="Pages.Custom" />
                    </RadioButtons>
                    <TextBox
                        Width="240"
                        HorizontalAlignment="Left"
                        local:L.AutomationName="Pages.BoxSpoken"
                        IsEnabled="{x:Bind ViewModel.CanNavigate, Mode=OneWay}"
                        local:L.PlaceholderText="Pages.Placeholder"
                        Text="{x:Bind ViewModel.Pages.RangeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Visibility="{x:Bind ViewModel.Pages.IsCustom, Mode=OneWay}" />
                    <TextBlock
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.Pages.ErrorText}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.Pages.ShowsError, Mode=OneWay}" />
                </StackPanel>

                <!--  Several pages of one PDF: a file per page, or one drawing with the pages side by side  -->
                <RadioButtons
                    local:L.Header="Queue.OutputHeader"
                    IsEnabled="{x:Bind ViewModel.CanNavigate, Mode=OneWay}"
                    SelectedIndex="{x:Bind ViewModel.OutputModeIndex, Mode=TwoWay}"
                    Visibility="{x:Bind ViewModel.ShowsOutputMode, Mode=OneWay}">
                    <RadioButton local:L.Content="Queue.OutputPerPage" />
                    <RadioButton local:L.Content="Queue.OutputCombined" />
                </RadioButtons>

                <TextBlock
                    Style="{StaticResource SecondaryCaptionTextStyle}"
                    Text="{x:Bind ViewModel.QueueStatusText, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!--  Empty: the drop area  -->
        <Grid
            AllowDrop="True"
            DragOver="OnDragOver"
            Drop="OnDrop"
            Visibility="{x:Bind ViewModel.ShowsEmpty, Mode=OneWay}">
            <Border
                Height="400"
                Padding="24"
                Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Rectangle
                        Fill="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        RadiusX="8"
                        RadiusY="8"
                        Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                        StrokeDashArray="4,3"
                        StrokeThickness="1" />
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">
                        <FontIcon
                            HorizontalAlignment="Center"
                            AutomationProperties.AccessibilityView="Raw"
                            FontSize="40"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Glyph="&#xE898;" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource BodyTextBlockStyle}"
                            local:L.Text="Architecture.ToCad.DropHere" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource SecondaryCaptionTextStyle}"
                            local:L.Text="Architecture.ToCad.DropFormats" />
                        <Button
                            x:Name="PickFileButton"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Center"
                            Command="{x:Bind ViewModel.PickSourceCommand}"
                            local:L.Content="Input.ChooseMany"
                            Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!--  Reading: the picture is being looked at  -->
        <Border
            Padding="24"
            Style="{StaticResource CardBorderStyle}"
            Visibility="{x:Bind ViewModel.ShowsReading, Mode=OneWay}">
            <StackPanel Spacing="20">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="{x:Bind ViewModel.ReadingTitle, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                        <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" local:L.Text="Architecture.Reading.Caption" />
                    </StackPanel>
                    <Button
                        x:Name="CancelReadingButton"
                        Grid.Column="1"
                        VerticalAlignment="Top"
                        Command="{x:Bind ViewModel.CancelReadingCommand}"
                        local:L.Content="Architecture.Reading.Cancel">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Escape" />
                        </Button.KeyboardAccelerators>
                    </Button>
                </Grid>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar
                        VerticalAlignment="Center"
                        local:L.AutomationName="Processing.ProgressSpoken"
                        Maximum="100"
                        Value="{x:Bind ViewModel.ReadingPercent, Mode=OneWay}" />
                    <TextBlock
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="{x:Bind ViewModel.ReadingProgressText, Mode=OneWay}" />
                </Grid>
            </StackPanel>
        </Border>

        <!--  The item shown could not be read: why, and the way on  -->
        <Border
            Padding="24"
            Style="{StaticResource CardBorderStyle}"
            Visibility="{x:Bind ViewModel.ShowsFailedItem, Mode=OneWay}">
            <StackPanel Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon
                        AutomationProperties.AccessibilityView="Raw"
                        FontSize="20"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Glyph="&#xEA39;" />
                    <TextBlock
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        local:L.Text="Queue.Failed.Title" />
                </StackPanel>
                <TextBlock
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind ViewModel.SourceName, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap"
                    ToolTipService.ToolTip="{x:Bind ViewModel.SourcePath, Mode=OneWay}" />
                <TextBlock
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="{x:Bind ViewModel.FailedItemMessage, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <Button
                    x:Name="RemoveFailedButton"
                    Command="{x:Bind ViewModel.RemoveFailedCommand}"
                    local:L.Content="Queue.Remove"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Border>

        <!--  Review  -->
        <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.ShowsReview, Mode=OneWay}">

            <!--  Many unclear areas, and this device can upscale  -->
            <InfoBar
                IsClosable="False"
                IsOpen="True"
                Message="{x:Bind ViewModel.UnclearMessage, Mode=OneWay}"
                Severity="Warning"
                Title="{x:Bind ViewModel.UnclearTitle, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsUnclear, Mode=OneWay}">
                <InfoBar.Content>
                    <StackPanel
                        Margin="0,8,0,8"
                        Orientation="Horizontal"
                        Spacing="8">
                        <SplitButton
                            x:Name="UpscaleSplit"
                            AutomationProperties.Name="{x:Bind ViewModel.UpscaleButtonSpoken, Mode=OneWay}"
                            Command="{x:Bind ViewModel.UpscaleDefaultCommand}"
                            Content="{x:Bind ViewModel.UpscaleButtonText, Mode=OneWay}">
                            <SplitButton.Flyout>
                                <MenuFlyout x:Name="UpscaleMenu" Placement="BottomEdgeAlignedLeft" />
                            </SplitButton.Flyout>
                        </SplitButton>
                        <Button Command="{x:Bind ViewModel.SkipUpscaleCommand}" local:L.Content="Architecture.Unclear.Skip" />
                    </StackPanel>
                </InfoBar.Content>
            </InfoBar>

            <!--  Many unclear areas, and this device can't upscale this picture  -->
            <InfoBar
                IsClosable="False"
                IsOpen="True"
                Message="{x:Bind ViewModel.NotEligibleMessage, Mode=OneWay}"
                Severity="Error"
                local:L.Title="Upscale.UnavailableTitle"
                Visibility="{x:Bind ViewModel.IsNotEligible, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button Command="{x:Bind ViewModel.ContinueWithoutUpscaleCommand}" local:L.Content="Architecture.NotEligible.Continue" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!--  Upscaling  -->
            <InfoBar
                IsClosable="False"
                IsOpen="True"
                Severity="Informational"
                Title="{x:Bind ViewModel.UpscalingTitle, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsUpscaling, Mode=OneWay}">
                <InfoBar.Content>
                    <Grid Margin="0,8,0,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar
                            VerticalAlignment="Center"
                            local:L.AutomationName="Architecture.Upscaling.Progress"
                            Maximum="100"
                            Value="{x:Bind ViewModel.UpscalePercent, Mode=OneWay}" />
                        <TextBlock
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind ViewModel.UpscaleProgressText, Mode=OneWay}" />
                        <Button
                            x:Name="CancelUpscaleButton"
                            Grid.Column="2"
                            Command="{x:Bind ViewModel.CancelUpscaleCommand}"
                            local:L.Content="Processing.Cancel">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Escape" />
                            </Button.KeyboardAccelerators>
                        </Button>
                    </Grid>
                </InfoBar.Content>
            </InfoBar>

            <!--  Ready  -->
            <InfoBar
                IsClosable="False"
                IsOpen="True"
                Message="{x:Bind ViewModel.ReadyMessage, Mode=OneWay}"
                Severity="Success"
                local:L.Title="Architecture.Ready.Title"
                Visibility="{x:Bind ViewModel.IsReady, Mode=OneWay}" />

            <!--  Skipped  -->
            <InfoBar
                IsClosable="False"
                IsOpen="True"
                Message="{x:Bind ViewModel.SkippedMessage, Mode=OneWay}"
                Severity="Warning"
                local:L.Title="Architecture.Skipped.Title"
                Visibility="{x:Bind ViewModel.IsSkipped, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button
                        Command="{x:Bind ViewModel.UpscaleDefaultCommand}"
                        Content="{x:Bind ViewModel.SkippedActionText, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.CanUpscale, Mode=OneWay}" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!--  A DXF or a PDF drawn with lines: converted as it is  -->
            <InfoBar
                IsClosable="False"
                IsOpen="True"
                Message="{x:Bind ViewModel.VectorMessage, Mode=OneWay}"
                Severity="Informational"
                Title="{x:Bind ViewModel.VectorTitle, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsVectorBanner, Mode=OneWay}" />

            <!--  Nothing to trace  -->
            <InfoBar
                IsClosable="False"
                IsOpen="True"
                Message="{x:Bind ViewModel.NothingFoundMessage, Mode=OneWay}"
                Severity="Error"
                Title="{x:Bind ViewModel.NothingFoundTitle, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsNothingFound, Mode=OneWay}" />

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="380" />
                </Grid.ColumnDefinitions>

                <!--  The preview: the picture with a box around each thing found  -->
                <Border Padding="16" Style="{StaticResource CardBorderStyle}">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Spacing="2">
                            <TextBlock
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind ViewModel.SourceName, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap"
                                ToolTipService.ToolTip="{x:Bind ViewModel.SourcePath, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind ViewModel.SizeCaption, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind ViewModel.TypeCaption, Mode=OneWay}" />
                        </StackPanel>

                        <Grid Grid.Row="1" MinHeight="240">
                            <Border
                                x:Name="PreviewFrame"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                Visibility="{x:Bind ViewModel.HasPreview, Mode=OneWay}">
                                <Viewbox MaxHeight="460" Stretch="Uniform">
                                    <Canvas x:Name="PreviewCanvas">
                                        <Image
                                            x:Name="PreviewImage"
                                            AutomationProperties.Name="{x:Bind ViewModel.PreviewAlt, Mode=OneWay}"
                                            Stretch="Fill" />
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            <FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                AutomationProperties.AccessibilityView="Raw"
                                FontSize="64"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE8A5;"
                                Visibility="{x:Bind ViewModel.HasNoPreview, Mode=OneWay}" />
                        </Grid>

                        <StackPanel
                            Grid.Row="2"
                            Orientation="Horizontal"
                            Spacing="20"
                            Visibility="{x:Bind ViewModel.IsRaster, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Rectangle
                                    Width="14"
                                    Height="14"
                                    VerticalAlignment="Center"
                                    StrokeThickness="2"
                                    Style="{StaticResource OverlayIncludedStyle}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SecondaryCaptionTextStyle}"
                                    local:L.Text="Architecture.Legend.Included" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Rectangle
                                    Width="14"
                                    Height="14"
                                    VerticalAlignment="Center"
                                    StrokeDashArray="3,2"
                                    StrokeThickness="1.5"
                                    Style="{StaticResource OverlayExcludedStyle}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SecondaryCaptionTextStyle}"
                                    local:L.Text="Architecture.Legend.Excluded" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Rectangle
                                    Width="14"
                                    Height="14"
                                    VerticalAlignment="Center"
                                    StrokeThickness="1.5"
                                    Style="{StaticResource OverlayUnclearStyle}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SecondaryCaptionTextStyle}"
                                    local:L.Text="Architecture.Legend.Unclear" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  What was found, and how it is saved  -->
                <Border
                    Grid.Column="1"
                    Padding="16"
                    VerticalAlignment="Top"
                    Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="12">

                        <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsRaster, Mode=OneWay}">
                            <StackPanel Spacing="2">
                                <TextBlock
                                    AutomationProperties.HeadingLevel="Level2"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    local:L.Text="Architecture.Objects.Title" />
                                <TextBlock
                                    Style="{StaticResource SecondaryCaptionTextStyle}"
                                    TextWrapping="Wrap"
                                    local:L.Text="Architecture.Objects.Hint" />
                            </StackPanel>
                            <ListView
                                x:Name="ObjectList"
                                local:L.AutomationName="Architecture.Objects.Title"
                                IsItemClickEnabled="False"
                                ItemContainerStyle="{StaticResource ObjectItemStyle}"
                                ItemsSource="{x:Bind ViewModel.Rows}"
                                SelectionMode="Multiple">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ObjectRow">
                                        <Grid AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock
                                                    Style="{StaticResource BodyTextBlockStyle}"
                                                    Text="{x:Bind Name}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="NoWrap" />
                                                <TextBlock
                                                    Style="{StaticResource SecondaryCaptionTextStyle}"
                                                    Text="{x:Bind Description, Mode=OneWay}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="NoWrap" />
                                            </StackPanel>
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource SecondaryCaptionTextStyle}"
                                                Text="{x:Bind Count}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock
                                Style="{StaticResource SecondaryCaptionTextStyle}"
                                TextWrapping="Wrap"
                                local:L.Text="Architecture.Objects.None"
                                Visibility="{x:Bind ViewModel.ShowsNothingTicked, Mode=OneWay}" />
                        </StackPanel>

                        <TextBlock
                            Style="{StaticResource SecondaryCaptionTextStyle}"
                            TextWrapping="Wrap"
                            Text="{x:Bind ViewModel.VectorHint, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsVector, Mode=OneWay}" />

                        <!--  A PDF drawn with lines: unit and scale of the drawing, and two switches.  -->
                        <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.ShowsPdfOptions, Mode=OneWay}">
                            <ComboBox
                                HorizontalAlignment="Stretch"
                                local:L.Header="Cad.UnitHeader"
                                ItemsSource="{x:Bind ViewModel.Pdf.Units}"
                                SelectedItem="{x:Bind ViewModel.Pdf.SelectedUnit, Mode=TwoWay}" />
                            <ComboBox
                                HorizontalAlignment="Stretch"
                                local:L.Header="Cad.ScaleHeader"
                                ItemsSource="{x:Bind ViewModel.Pdf.Scales}"
                                SelectedItem="{x:Bind ViewModel.Pdf.SelectedScale, Mode=TwoWay}" />
                            <NumberBox
                                local:L.AutomationName="Cad.CustomScaleSpoken"
                                local:L.Header="Cad.CustomScaleHeader"
                                Minimum="1"
                                local:L.PlaceholderText="Cad.CustomScalePlaceholder"
                                SpinButtonPlacementMode="Compact"
                                Value="{x:Bind ViewModel.Pdf.CustomDenominator, Mode=TwoWay}"
                                Visibility="{x:Bind ViewModel.Pdf.IsCustomScale, Mode=OneWay}" />
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Style="{StaticResource BodyTextBlockStyle}" local:L.Text="Cad.KeepText" />
                                    <TextBlock
                                        Style="{StaticResource SecondaryCaptionTextStyle}"
                                        Text="{x:Bind ViewModel.Pdf.KeepTextNote, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch
                                    Grid.Column="1"
                                    MinWidth="0"
                                    local:L.AutomationName="Cad.KeepText"
                                    IsEnabled="{x:Bind ViewModel.Pdf.CanKeepText, Mode=OneWay}"
                                    IsOn="{x:Bind ViewModel.Pdf.KeepText, Mode=TwoWay}"
                                    OffContent=""
                                    OnContent="" />
                            </Grid>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Style="{StaticResource BodyTextBlockStyle}" local:L.Text="Cad.JoinLines" />
                                    <TextBlock
                                        Style="{StaticResource SecondaryCaptionTextStyle}"
                                        TextWrapping="Wrap"
                                        local:L.Text="Cad.JoinLinesNote" />
                                </StackPanel>
                                <ToggleSwitch
                                    Grid.Column="1"
                                    MinWidth="0"
                                    local:L.AutomationName="Cad.JoinLines"
                                    IsOn="{x:Bind ViewModel.Pdf.JoinLines, Mode=TwoWay}"
                                    OffContent=""
                                    OnContent="" />
                            </Grid>
                        </StackPanel>

                        <Rectangle
                            Height="1"
                            Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                            Visibility="{x:Bind ViewModel.ShowsFormatChoice, Mode=OneWay}" />

                        <RadioButtons
                            MaxColumns="2"
                            local:L.Header="Architecture.CadFormat"
                            SelectedIndex="{x:Bind ViewModel.FormatIndex, Mode=TwoWay}"
                            Visibility="{x:Bind ViewModel.ShowsFormatChoice, Mode=OneWay}">
                            <RadioButton Content="DWG" />
                            <RadioButton Content="DXF" />
                        </RadioButtons>

                        <Grid ColumnSpacing="12" Visibility="{x:Bind ViewModel.IsRaster, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" local:L.Text="Architecture.Scale.Label" />
                                <TextBlock
                                    Style="{StaticResource SecondaryCaptionTextStyle}"
                                    Text="{x:Bind ViewModel.CalibrationCaption, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <Button
                                x:Name="CalibrateButton"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Click="OnCalibrateClick"
                                Content="{x:Bind ViewModel.CalibrationButtonText, Mode=OneWay}"
                                IsEnabled="{x:Bind ViewModel.HasPreview, Mode=OneWay}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <FontIcon
                        AutomationProperties.AccessibilityView="Raw"
                        FontSize="16"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xEA18;" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource SecondaryCaptionTextStyle}"
                        local:L.Text="Privacy.Note" />
                </StackPanel>
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="PickAnotherButton"
                        Command="{x:Bind ViewModel.PickSourceCommand}"
                        local:L.Content="Architecture.PickAnother" />
                    <Button Command="{x:Bind ViewModel.AddSourcesCommand}" local:L.Content="Queue.AddFiles" />
                    <Button
                        x:Name="ConvertButton"
                        Command="{x:Bind ViewModel.ConvertCommand}"
                        Content="{x:Bind ViewModel.ConvertLabel, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <!--  Converting, done, failed  -->
        <Border
            Padding="24"
            Style="{StaticResource CardBorderStyle}"
            Visibility="{x:Bind ViewModel.Run.IsActive, Mode=OneWay}">
            <views:RunStatusView x:Name="RunView" />
        </Border>
    </StackPanel>
</UserControl>
