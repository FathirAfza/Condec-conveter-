<Project Sdk="Microsoft.NET.Sdk">

  <!-- net10.0: portable core (pipeline, verification, history, CAD conversion), tested on any OS.
       Windows target: adds the converters that call WinRT APIs, from Platform/Windows. -->
  <PropertyGroup>
    <TargetFrameworks>net10.0;$(CondecWindowsTargetFramework)</TargetFrameworks>
    <RootNamespace>Condec.Core</RootNamespace>
    <!-- The strings in Resources/Strings.resx are English; other languages are satellite assemblies. -->
    <NeutralLanguage>en</NeutralLanguage>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The generated P/Invoke and COM code (LibraryImport, GeneratedComInterface) in Platform/Windows/Devices. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <SupportedOSPlatformVersion>$(CondecWindowsMinVersion)</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'windows'">
    <Compile Remove="Platform\Windows\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PdfPig" />
    <PackageReference Include="ACadSharp" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Condec.Tests" />
  </ItemGroup>

</Project>
